				Copyright <SWGEmu>
		See file COPYING for copying conditions.

	Companion System (isolated from the base Creature Handler pet / Droid systems).
	See docs/companion_system/NOTES.md at the repository root for the full
	design write-up and a list of assumptions made while integrating this
	feature with the existing Core3 architecture.
*/

package server.zone.objects.companion;

import server.zone.objects.creature.ai.AiAgent;
import server.zone.objects.creature.CreatureObject;
import server.zone.objects.companion.CompanionControlDevice;
import server.zone.objects.tangible.weapon.WeaponObject;
import server.zone.objects.tangible.TangibleObject;
import server.zone.objects.scene.SceneObject;
import system.util.VectorMap;
include system.util.Vector;

/**
 * CompanionObject
 *
 * The live, in-world actor for the Companion Master ("companion_master") profession.
 * Deliberately extends AiAgent (which itself extends CreatureObject) so it gets the
 * full pathfinding / combat-state / behavior-tree machinery that Core3 pets rely on,
 * while remaining a completely distinct object type (isCompanionObject() is
 * auto-generated by the IDL compiler and is used everywhere in this feature instead
 * of the existing isPet() / isAiAgent()-based Creature Handler checks, so the two
 * systems never cross-recognize each other's actors).
 */
@json
class CompanionObject extends AiAgent {

	/** Weak-linked back-reference to the owning datapad device. Companions do NOT use
	 * the CreatureObject.controlDevice field (that field is typed ControlDevice, the
	 * Creature Handler / Droid base class) -- that is the crux of the isolation
	 * requirement, so the link is stored here instead. */
	@weakReference
	protected CompanionControlDevice companionControlDevice;

	/** Current / maximum vitality mirror kept on the live object for fast AI-side
	 * reads; the authoritative, persisted copy lives on CompanionControlDevice so
	 * that vitality survives storing/despawning. */
	protected int vitality;
	protected int maxVitality;

	/** Skill boxes the companion has learned, e.g. "companion_master_husbandry_01",
	 * "combat_bountyhunter_novice", "jedi_teraskappa_01". Fully isolated from the
	 * player SkillManager skill tree -- this is a private ledger owned by the
	 * companion, never written to PlayerObject. */
	@dereferenced
	protected Vector<string> learnedSkills;

	/** Companion System (2026-07-12, "badge tracking" pass) -- badges the
	 * companion itself has earned by mastering a real combat profession
	 * (awarded by CompanionSkillTrainer::trainSkill() the moment it grants a
	 * profession's own "_master" skill tier -- mirrors how a real player earns
	 * a Master badge via PlayerManager::awardBadge(), but isolated to the
	 * companion's own ledger, same as learnedSkills/experiencePools). Jedi
	 * eligibility (see isJediEligible()) checks this list instead of raw
	 * learnedSkills strings -- holding the badge is proof mastery happened at
	 * least once, even if the companion is later untrained out of that skill. */
	@dereferenced
	protected Vector<string> companionBadges;

	/**
	 * Companion System (2026-07-17, "pet command port" pass, per user
	 * request) -- object IDs of players this companion's owner has marked
	 * as friends via /companionfriend (mirrors the real Creature Handler
	 * pet's Friend order, PetFriendCommand.h's device-side friend list).
	 * A friend is never auto-attacked by interceptThreatToOwner() even if
	 * they attack the owner (e.g. a duel). Persisted with the companion.
	 * @dereferenced: value member (not Reference-wrapped) -- required for
	 * the generated JSON serializer, same as PlayerObject.idl's own
	 * victimList/ownedStructures Vector<unsigned long> members.
	 */
	@dereferenced
	protected Vector<unsigned long> friendIds;

	/**
	 * Companion System (2026-07-20, "return to escort target after the
	 * loot/harvest sweep" -- per user request). The standing escort order
	 * set by /companionfollowother: who this companion should resume
	 * following once a temporary interruption (combat, the post-battle
	 * loot/harvest sweep, etc.) ends. Null means "follow the owner" (the
	 * default) -- cleared back to null by /companionfollow, an explicit
	 * order back onto the owner. Distinct from the inherited AiAgent
	 * followObject field, which the sweep, attack orders, patrol, etc. all
	 * repeatedly overwrite for their own transient movement needs; this
	 * field is the durable "who am I actually escorting" preference that
	 * survives all of that. Weak reference -- just a standing pointer to
	 * whichever player is being escorted, not an ownership link.
	 */
	@weakReference
	protected CreatureObject escortTarget;

	/** Per-xp-type pools, e.g. "companion_master_xp", "marksman_xp". Isolated from
	 * PlayerObject/PlayerManager::awardExperience -- companions keep their own xp
	 * ledger so awarding a companion xp can never leak into player xp caps or vice
	 * versa (see NOTES.md, section "Experience & isolation"). */
	@dereferenced
	protected VectorMap<string, int> experiencePools;

	/** Dynamically calculated whenever learnedSkills changes; mirrors how player
	 * combat level is derived from skill boxes. */
	protected int combatLevel;

	/** Companion-local behavior state, independent of the Creature Handler
	 * PetManager::FOLLOW/STAY/PATROL/ATTACK training constants (those belong to
	 * the isolated pet system). Driven by /hpet and by CompanionThreatObserver. */
	protected int companionState;

	/** Companion System -- one-time first-launch flow (spec: baseline stat
	 * migration + starter profession choice happen exactly once, in-world,
	 * the first time this companion is summoned; every migration after that
	 * only happens through the canonical places, i.e. never again
	 * automatically). Set true only once the starter profession SUI has
	 * actually been answered -- see CompanionControlDeviceImplementation::
	 * spawnObject() and CompanionSkillTrainer::sendStarterProfessionChoice(). */
	protected boolean firstLaunchComplete;

	/** Companion System (2026-07-15, "companion taxi" feature -- built from
	 * the cosmetic-piggyback design researched in NOTES.md, "Follow-up:
	 * cosmetic companion-taxi feasibility research"; REVISED 2026-07-15,
	 * "vehicle mimicry redesign" -- see NOTES.md). All transient by
	 * design: a ride never survives a store/despawn/server restart --
	 * stopTaxiRide() is called from every companion exit path, and a
	 * reloaded companion simply starts with no ride active. The vehicle is
	 * ALWAYS a cosmetic, unridden, non-persistent shell whose position
	 * mirrors the companion's own AI-driven movement each tick -- nobody
	 * rides it, no mount/RIDER-slot machinery is involved at all (the
	 * earlier "real mount" experiment was reverted: mounting the companion
	 * onto a static, non-AI-driven vehicle shell fought with the
	 * companion's own AI pathing and caused it to teleport instead of
	 * driving -- confirmed by direct live testing). The shell's template
	 * is no longer hardcoded to the x31 -- see vehicleTemplateCRC in
	 * startTaxiRide() -- so it can match whatever vehicle the owner is
	 * actually riding. taxiHasDestination distinguishes the two calling
	 * shapes that now share this same mechanism: true (the Taxi dialog --
	 * drive to a specific waypoint, then stop) vs false (the general
	 * "owner just called their own vehicle" escort -- no destination, just
	 * keep mirroring alongside whatever the companion is already doing
	 * until the owner stores their vehicle again).
	 *
	 * Lead/catch-up throttle (2026-07-15, per user request): the boosted
	 * pace is no longer a flat constant -- it's computed once at ride
	 * start as 15% faster than the spawned vehicle template's OWN real
	 * speed (taxiBoostedRunSpeed/WalkSpeed), so it scales correctly
	 * whatever vehicle the owner is actually using. If the companion gets
	 * more than 70m ahead of the owner it drops back to its normal
	 * (pre-ride, taxiSavedRunSpeed/WalkSpeed) pace -- taxiThrottled
	 * remembers this across ticks -- and only resumes the boosted pace
	 * once the owner is back within 25m. */
	protected transient SceneObject taxiVehicle;
	protected transient boolean taxiActive;
	protected transient boolean taxiHasDestination;
	protected transient boolean taxiThrottled;
	protected transient float taxiSavedRunSpeed;
	protected transient float taxiSavedWalkSpeed;
	protected transient float taxiBoostedRunSpeed;
	protected transient float taxiBoostedWalkSpeed;
	protected transient float taxiDestX;
	protected transient float taxiDestY;

	/**
	 * True auto-taxi (2026-07-16, per user choice "option 1" -- see NOTES.md):
	 * on a destination ride, the OWNER is auto-driven too -- their real
	 * vehicle is stowed and they're mounted onto this second, server-driven
	 * carriage agent (same construction as taxiVehicle, wearing the owner's
	 * own vehicle's model) that AI-FOLLOWs the companion's taxi the whole
	 * way. Zero player input; the native dismount button is the opt-out
	 * (the tick notices the owner unparented and quietly retires the
	 * carriage while the companion drives on). Transient like everything
	 * else here -- never survives a reload.
	 */
	protected transient SceneObject taxiOwnerCarriage;

	/**
	 * Departure delay (2026-07-16, per user request): on a destination
	 * ride the driver holds still (STAY) for 5 seconds after spawning so
	 * the owner has time to click it and /follow before it drives off.
	 * Millisecond timestamp of the actual departure; 0 = already departed
	 * (or an escort ride, which never waits). updateTaxiTick() flips the
	 * driver to PATROL once the clock passes it.
	 */
	protected transient unsigned long taxiDepartureTime;

	/**
	 * GO button (2026-07-30, per user request "the vehicle only starts
	 * moving once the player actually clicks it"): replaces the old flat
	 * 5-second departure hold with a real player-facing confirmation.
	 * startTaxiRide() no longer pre-arms taxiDepartureTime -- it sets this
	 * flag true and pops a SuiMessageBox (see CompanionTaxiGoSuiCallback.h)
	 * instead. updateTaxiTick() re-schedules and bails while this stays
	 * true (same early-return shape as its existing timer/proximity gate).
	 * Pressing GO clears this and sets taxiDepartureTime to "now," letting
	 * the very next tick's unchanged proximity check decide the actual
	 * departure. True means "awaiting the player's click"; false means
	 * "no ride pending, or the player already confirmed."
	 */
	protected transient boolean taxiAwaitingGoConfirm;

	/**
	 * Post-combat auto-loot & ranger auto-harvest (2026-07-18, per user
	 * request -- see NOTES.md). lootSweepActive is the re-entry guard for
	 * the poll-then-sweep task chain (transient -- a reload simply means
	 * no sweep is running). harvestPreference is PERSISTED: the resource
	 * this companion harvests from creature corpses, stored as the same
	 * selectedID codes CreatureManagerImplementation::harvest() uses --
	 * 0 = not chosen yet (owner is asked once, then it sticks), 234 = meat,
	 * 235 = hide, 236 = bone. Changeable any time from the companion's
	 * radial Harvesting submenu (CompanionMenuComponent).
	 */
	protected transient boolean lootSweepActive;
	protected int harvestPreference;

	/**
	 * Companion personality (2026-07-30, growth/personality feature batch).
	 * Rolled once at creation and then fixed for the companion's lifetime --
	 * flavors AI decision-making (e.g. flee thresholds, aggression) without
	 * adding a whole new stat block. 0 = unassigned (legacy companions
	 * created before this field existed); PERSONALITY_* below otherwise.
	 */
	protected int personalityType;

	public static final int PERSONALITY_BRAVE = 1;
	public static final int PERSONALITY_STEADY = 2;
	public static final int PERSONALITY_CAUTIOUS = 3;
	public static final int PERSONALITY_RECKLESS = 4;
	public static final int PERSONALITY_VIGILANT = 5;

	/**
	 * Companion Level (2026-07-30, growth/personality feature batch). A
	 * dedicated growth track for this companion, distinct from -- and
	 * progressing independently of -- any profession/skill leveling.
	 * Starts at 1 for every companion.
	 */
	protected int companionLevel;

	/**
	 * Flee suppression (2026-07-30, growth/personality feature batch).
	 * Epoch millis timestamp until which this companion's low-health flee
	 * behavior is suppressed; 0 = not currently fleeing / no suppression
	 * active.
	 */
	protected long fleeingUntil;

	/**
	 * Auto Skill-Training Walkup one-shot flag (AUTO_SKILL_TRAIN_WALKUP_2026_07_30).
	 * Epoch millis deadline until which this companion is either
	 * walking to its owner or has just had the trainer Skill Tree SUI
	 * sent for a newly XP-ready untrained skill; 0 = not currently
	 * pending. Same shape/convention as fleeingUntil above: a single
	 * timestamp field doubles as both "is this in progress" (nonzero)
	 * and "give up by when" (the deadline itself) rather than two
	 * separate fields. Cleared back to 0 the moment the SUI is
	 * actually sent (or the companion becomes busy en route, or the
	 * walk-over deadline passes without arriving) -- see
	 * CompanionObjectImplementation.cpp's runSkillTrainWalkupTick().
	 */
	protected long trainingReadyUntil;

	/** Companion System (2026-07-29 fix, per Nick: "sometimes they run off
	 * and never return unless i press follow"). isInCombat()/owner->isInCombat()
	 * are plain CreatureState::COMBAT bitmask flags cleared only when a
	 * creature's defenderList empties out -- but that cleanup only ever
	 * runs for the dying object's own list and the credited killer's
	 * reference to it; a THIRD PARTY (e.g. this companion, fighting
	 * alongside the owner against something someone else got the kill
	 * credit for) never gets reciprocally scrubbed, so isInCombat() can get
	 * stuck true forever with nothing left to actually fight. Counts polls
	 * of runPostCombatSweepCheck()'s "still fighting" branch so it can
	 * force-break out via CombatManager::forcePeace() rather than trusting
	 * isInCombat() to ever clear naturally on its own. Reset to 0 every
	 * time a fresh sweep is armed. */
	protected transient int combatStuckPollCount;

	/**
	 * Keep-up monitor (2026-07-18, per user request "companions shouldn't
	 * ever be further than 25 meters behind the user"): a light 2-second
	 * watchdog started at every summon. A FOLLOWing companion that falls
	 * more than 25m behind its owner gets a 1.8x speed boost until it has
	 * closed back to 10m, then its normal pace is restored. Skipped
	 * entirely during taxi rides (the ride manages pace) and combat. All
	 * transient -- a reload just restarts the monitor on next summon.
	 */
	protected transient boolean keepUpMonitorActive;
	protected transient boolean keepUpBoosted;
	protected transient float keepUpBaseRunSpeed;
	protected transient float keepUpBaseWalkSpeed;

	/**
	 * Chase movement-speed throttle (2026-07-30, per Nick: companions
	 * chasing an attack target look like they "teleport 60 meters in 2
	 * seconds" -- use the OWNER's own walk speed as the companion's
	 * chase speed). This is movement speed only, unrelated to combat
	 * attack/weapon speed. preChaseRunSpeed/preChaseWalkSpeed save this
	 * companion's own runSpeed/walkSpeed from just before the throttle
	 * kicked in, so runKeepUpTick() can restore them once the companion
	 * leaves companionState == ATTACK. chaseWalkSpeedActive records
	 * whether the throttle is currently active, so the tick doesn't
	 * re-save an already-throttled speed as if it were the companion's
	 * real original pace. Same save/restore shape as
	 * keepUpBaseRunSpeed/keepUpBaseWalkSpeed/keepUpBoosted above -- see
	 * runKeepUpTick() in CompanionObjectImplementation.cpp.
	 */
	protected transient float preChaseRunSpeed;
	protected transient float preChaseWalkSpeed;
	protected transient boolean chaseWalkSpeedActive;

	/**
	 * Escort dismount-in-close fix (2026-07-18 hotfix): the owner must have
	 * actually RIDDEN their vehicle at some point during this escort before
	 * "owner is not mounted" is treated as a dismount. Without this, the
	 * escort's very first tick -- which runs before the owner has even
	 * climbed onto their freshly-called vehicle -- saw not-mounted +
	 * within-10m and ended the ride instantly (live-reported as "companion
	 * vehicles no longer showing up").
	 */
	protected transient boolean taxiOwnerWasMounted;

	/**
	 * Companion System (2026-07-20, "massive battlefield" pass, per user
	 * request) -- the last EXPLICIT order the owner gave (FOLLOW/STAY/
	 * GUARD), independent of companionState. companionState gets
	 * temporarily overwritten by things this field is deliberately immune
	 * to: interceptThreatToOwner() punches it to ATTACK the instant a
	 * posted companion defends the owner (by design -- "protect the
	 * master" overrides STAY), and the post-combat loot/harvest sweep
	 * (runSweepStep()) cycles it through PATROL/FOLLOW while walking
	 * corpse to corpse. Without a durable record of "what was I actually
	 * ordered to do," there'd be no way for either of those interruptions
	 * to know a companion should go back to standing guard at its post
	 * instead of defaulting to FOLLOW afterward. Set only by the four
	 * order commands (Stay, Guard, Follow, FollowOther) and by
	 * FormationManager::arrangeFollowers() (formup / follow's own
	 * formation-refresh tail call) -- never by combat or the sweep. See
	 * endSweep() in CompanionObjectImplementation.cpp and
	 * CompanionReturnCommand.h.
	 */
	protected int standingOrder;

	/**
	 * Companion System (2026-07-20) -- who this companion is guarding
	 * under a GUARD standingOrder, when guarding a moving creature rather
	 * than a fixed spot (/companionguard on a friendly target keeps
	 * companionState == GUARD + followObject == this target; guarding an
	 * OBJECT instead reuses STAY + homeLocation, see CompanionGuardCommand.h,
	 * so this field is only ever set for the creature-guarding case).
	 * Weak reference, same rationale as escortTarget.
	 */
	@weakReference
	protected CreatureObject guardTarget;

	/**
	 * Companion System (2026-07-20, "Master Jedi companion" pass, per user
	 * request) -- true if this companion is a Master Jedi recruited on the
	 * DARK side (vs. light side). Only meaningful when hasCompanionBadge()
	 * shows a Jedi mastery badge -- see CompanionSkillTrainer::
	 * grantMasterJediMastery(). No real alignment/councilType field exists
	 * anywhere on PlayerObject/CreatureObject to inherit from (confirmed by
	 * grep -- the real game's FRS light/dark council membership is tracked
	 * entirely separately, per-player, outside CreatureObject/PlayerObject
	 * -- see FrsManagerImplementation.cpp); this is a companion-only flag,
	 * same isolation posture as every other field on this class.
	 */
	protected boolean darkSideJedi;

	public static final int FOLLOW = 1;
	public static final int PATROL = 2;
	public static final int STAY = 3;
	public static final int ATTACK = 4;

	/**
	 * Companion System (2026-07-17, "pet command port" pass, per user
	 * request) -- /companionguard: the companion escorts a guarded target
	 * (the owner's current friendly target, or the owner themselves) while
	 * the existing owner-threat auto-defense keeps working. Mirrors the
	 * real Creature Handler pet's Guard order (PetGuardCommand.h).
	 */
	public static final int GUARD = 5;

	/**
	 * Theater Mode foundation (2026-07-30) -- a scripted companion show
	 * (birthday show / muster call / battle theater / "The Landing" /
	 * future shows) is directing this companion's movement/animation
	 * beat-by-beat. Suspends normal AI -- following, auto-combat-
	 * intercept (interceptThreatToOwner()), and the background keep-up
	 * tick's sub-behaviors (medic auto-care, flee/self-buff/idle-emote/
	 * skill-train-walkup, etc.) -- for the duration of the show, so
	 * none of them fight the show director's choreography. Shows
	 * themselves are responsible for setting this state on entry and
	 * restoring the companion's prior state (FOLLOW/STAY/GUARD/etc.) on
	 * exit -- this constant is purely the shared gate other systems
	 * check against.
	 */
	public static final int THEATER = 6;

	public CompanionObject() {
		Logger.setLoggingName("CompanionSystem");
		Logger.setLogging(false);
		Logger.setGlobalLogging(true);

		vitality = 100;
		maxVitality = 100;
		combatLevel = 0;
		companionState = FOLLOW;
		standingOrder = FOLLOW;
		darkSideJedi = false;
		firstLaunchComplete = false;

		taxiActive = false;
		taxiHasDestination = false;
		taxiThrottled = false;
		taxiSavedRunSpeed = 0;
		taxiSavedWalkSpeed = 0;
		taxiBoostedRunSpeed = 0;
		taxiBoostedWalkSpeed = 0;
		taxiDestX = 0;
		taxiDestY = 0;
		taxiOwnerCarriage = null;
		taxiDepartureTime = 0;
		taxiAwaitingGoConfirm = false;
		lootSweepActive = false;
		harvestPreference = 0;
		personalityType = 0;
		companionLevel = 1;
		fleeingUntil = 0;
		trainingReadyUntil = 0;
		keepUpMonitorActive = false;
		keepUpBoosted = false;
		keepUpBaseRunSpeed = 0;
		keepUpBaseWalkSpeed = 0;
		preChaseRunSpeed = 0;
		preChaseWalkSpeed = 0;
		chaseWalkSpeedActive = false;
		taxiOwnerWasMounted = false;

		experiencePools.setAllowOverwriteInsertPlan();
		experiencePools.setNullValue(0);
	}

	@read
	public boolean isCompanionObject() {
		return true;
	}

	/**
	 * Companion System (2026-07-15, "companion stops following / leashes
	 * back home" fix -- see ai/companion.lua and NOTES.md): customAiMap is
	 * TRANSIENT on AiAgent, so a summoned companion reloaded from the
	 * database on server restart would otherwise reassemble its behavior
	 * trees from the generic wild-mobile defaults (leash-back-home) until
	 * the next store/re-summon. Re-assign the dedicated companion AI map
	 * before AiAgentImplementation::initializeTransientMembers() calls
	 * setAITemplate(). Mirrors spawnObject()'s setCustomAiMap() call.
	 */
	public native void initializeTransientMembers();

	/**
	 * Companion System (2026-07-15, "companion teleports/vanishes when the
	 * owner outranges it" fix -- see NOTES.md): AiAgent's leash() is the
	 * wild-mobile "race back to my fixed spawn-point home" reset, fired by
	 * setDestination()'s FOLLOWING branch whenever the agent is >75m from
	 * homeLocation with line of sight to its follow target broken (e.g.
	 * the owner drives off on a vehicle) -- exactly what the player
	 * experiences as the companion suddenly "teleporting" away mid-escort.
	 * A companion's home is its OWNER, never a map point: re-anchor
	 * homeLocation to the owner's current position and keep following
	 * instead. Falls back to the inherited behavior only when there is no
	 * living linked owner to anchor to.
	 * @pre { this locked }
	 */
	@preLocked
	public native void leash(boolean forcePeace = true);

	/**
	 * Companion Taxi / Vehicle Mimicry (2026-07-15 -- see the taxiVehicle
	 * field doc comment above and NOTES.md). Spawns a cosmetic vehicle
	 * shell (matching vehicleTemplateCRC -- pass 0 to fall back to the x31
	 * landspeeder), boosts the companion to vehicle pace, and starts the
	 * mirror tick. Any active ride is stopped first (idempotent).
	 *
	 * hasDestination = true (the Taxi dialog flow): routes the companion
	 * to (destX, destY) via its own proven AI patrol pathing; the ride
	 * ends automatically on arrival.
	 *
	 * hasDestination = false (the general "owner called their own
	 * vehicle" escort hook -- see VehicleControlDeviceImplementation::
	 * spawnObject()): destX/destY are ignored, the companion's existing
	 * companionState/movement is left completely untouched (follow/stay/
	 * patrol all keep working as before), and the ride only ends when
	 * stopTaxiRide() is called explicitly (the matching storeObject()
	 * hook).
	 * @pre { this locked }
	 * @returns true if the ride started
	 */
	@local
	public native boolean startTaxiRide(CreatureObject owner, float destX, float destY, boolean hasDestination = true, unsigned int vehicleTemplateCRC = 0);

	/**
	 * Companion Taxi (2026-07-15): tears the ride down -- despawns the
	 * cosmetic vehicle, restores saved speeds, and (optionally) resumes
	 * following the owner. Safe to call when no ride is active. Called
	 * from every companion exit path (store, death) as well as arrival.
	 * @pre { this locked }
	 */
	@local
	public native void stopTaxiRide(boolean resumeFollow);

	/**
	 * Companion Taxi (2026-07-15): one mirror/arrival tick -- repositions
	 * the cosmetic vehicle onto the companion's current position/heading
	 * and ends the ride once the destination is reached. Reschedules
	 * itself while the ride stays active.
	 * @pre { this locked }
	 */
	@local
	public native void updateTaxiTick();

	/**
	 * Companion Taxi multi-stop route (2026-07-16, per user request "pick
	 * multiple waypoints... once it reaches one, go to the next"): appends
	 * another waypoint to an ALREADY RUNNING destination ride. The driver's
	 * AI patrol queue IS the route (points are consumed leg by leg), so
	 * this just adds a patrol point and moves the arrival check's final
	 * destination along with it. Returns false when no destination ride is
	 * active right now -- the caller should startTaxiRide() instead.
	 * @pre { this locked }
	 */
	@local
	public native boolean addTaxiWaypoint(float destX, float destY);

	/**
	 * True auto-taxi (2026-07-16): retires the owner's server-driven
	 * carriage -- dismounts the owner (if still aboard) and despawns the
	 * carriage agent. Called from stopTaxiRide() on every ride exit, and
	 * from updateTaxiTick() when the owner has hopped off on their own
	 * (native dismount = the opt-out; the ride itself keeps going).
	 * Safe to call when no carriage exists.
	 * @pre { this locked }
	 */
	/**
	 * True auto-taxi (2026-07-16): dismounts the owner from their real
	 * vehicle if needed, stows that vehicle, then spawns the server-driven
	 * carriage (driver-style agent wearing the same vehicle model,
	 * AI-following the taxi) and mounts the owner on it. No-op unless a
	 * destination ride is active. Called from startTaxiRide()'s deferred
	 * kickoff task.
	 * @pre { owner locked, this crosslocked }
	 */
	@local
	public native void startOwnerAutoDrive(CreatureObject owner);

	@local
	public native void stopOwnerAutoDrive(boolean notifyOwner);

	@dirty
	public boolean isTaxiActive() {
		return taxiActive;
	}

	// Build fix (2026-07-30, build-fix-2) -- taxiDepartureTime is a
	// PRE-EXISTING field that, before today, was only ever touched
	// directly from inside CompanionObjectImplementation.cpp itself, so
	// it never needed a public accessor. CompanionTaxiGoSuiCallback.h
	// (this same day's taxi-GO-button patch) now needs to set it from
	// OUTSIDE this class, which requires the real public accessor pair.
	@dirty
	public unsigned long getTaxiDepartureTime() {
		return taxiDepartureTime;
	}

	@preLocked
	public void setTaxiDepartureTime(unsigned long time) {
		taxiDepartureTime = time;
	}

	// Build fix (2026-07-30, build-fix-2) -- taxiAwaitingGoConfirm (new
	// field, taxi-GO-button patch) also needs public accessors for the
	// same reason: CompanionTaxiGoSuiCallback.h reads/clears it from
	// outside this class.
	@dirty
	public boolean isTaxiAwaitingGoConfirm() {
		return taxiAwaitingGoConfirm;
	}

	@preLocked
	public void setTaxiAwaitingGoConfirm(boolean confirm) {
		taxiAwaitingGoConfirm = confirm;
	}

	/**
