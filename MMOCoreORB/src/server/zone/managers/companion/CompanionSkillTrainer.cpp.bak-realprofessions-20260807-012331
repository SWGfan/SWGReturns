// Companion System (2026-07-20, per user request) -- the colored skill
// TREE. The display universe is every profession skill the OWNER holds
// (what CAN be taught to the companion, same source as sendTrainList),
// grouped by profession root and ordered novice -> branches -> master.
// Each box renders GREEN (\#33FF33) if the companion has learned it, dim
// grey (\#888888) if not -- the "highlighted-green vs not" of the real
// Skills window. Tapping any box trains it AND its whole prerequisite
// chain (trainSkill's prereq recursion), then the window reopens showing
// the new greens (CompanionTrainSkillSuiCallback treeMode).
void CompanionSkillTrainer::sendSkillTree(CreatureObject* player, CompanionObject* companion) {
	if (player == nullptr || companion == nullptr) {
		return;
	}

	ManagedReference<PlayerObject*> ghost = player->getPlayerObject();

	if (ghost == nullptr) {
		return;
	}

	// Companion System (2026-07-28, per Nick's live feedback right after
	// the XP cost display shipped: "only show the skill boxes that the
	// companion has... if a companion doesnt have a novice skill box...
	// it shouldnt show those skills until i train them in that novice
	// class"): the profession list below is now built ENTIRELY from what
	// the COMPANION itself has learned (see the two loops further down --
	// immediate children of learned skills, and every learned skill
	// itself) -- a profession the companion has never touched (no novice
	// box, nothing) no longer appears on this screen at all, regardless of
	// what the OWNER personally holds. This removes what used to be the
	// very first source (every profession skill the owner personally
	// held, unconditionally) -- that was the direct cause of a fully-
	// mastered owner flooding every companion's sheet with professions
	// that companion has zero investment in (see the live report/
	// screenshot: MFencer's sheet showing a fully-populated "combat_
	// marksman" section at 0 XP banked). Starting a companion into a
	// BRAND NEW profession is still done via the separate "Train" flow
	// (sendTrainList(), dialog option 4) -- this screen (dialog option
	// 13) is purely a progress view for professions already underway,
	// matching Nick's own framing of what it should be.
	VectorMap<String, Vector<String> > byProfession;
	byProfession.setNullValue(Vector<String>());

	// Companion System (2026-07-27, same owner-gate fix as sendTrainList()
	// earlier tonight): the loop above only shows a profession skill if
	// the OWNER personally holds it -- a companion already partway up a
	// tree (e.g. via the starter-profession picker) would show nothing
	// further once past whatever the owner personally knows. Add every
	// immediate child of each of the companion's OWN already-learned
	// skills too (same Skill::getChildNode() tree-walk as
	// sendTrainList()), independent of what the owner holds.
	for (int i = 0; i < companion->getLearnedSkillCount(); ++i) {
		const String& learnedName = companion->getLearnedSkill(i);
		Skill* learnedSkill = SkillManager::instance()->getSkill(learnedName);

		if (learnedSkill == nullptr) {
			continue;
		}

		for (int c = 0; c < learnedSkill->getTotalChildren(); ++c) {
			const Skill* child = learnedSkill->getChildNode(c);

			if (child == nullptr) {
				continue;
			}

			const String& name = child->getSkillName();

			if (!name.beginsWith("combat_") && !name.beginsWith("crafting_") && !name.beginsWith("science_")
					&& !name.beginsWith("outdoors_") && !name.beginsWith("social_")) {
				continue;
			}

			int childFirstUnderscore = name.indexOf("_");
			int childSecondUnderscore = childFirstUnderscore >= 0 ? name.indexOf("_", childFirstUnderscore + 1) : -1;
			String childRoot = childSecondUnderscore > 0 ? name.subString(0, childSecondUnderscore) : name;

			Vector<String> childList = byProfession.get(childRoot);

			if (childList.contains(name)) {
				continue;
			}

			childList.add(name);
			byProfession.drop(childRoot);
			byProfession.put(childRoot, childList);
		}
	}

	// Companion System (2026-07-29, root-cause fix -- Nick: "its not
	// showign t he xp", MPistoleer's tree showing ONLY its one trained
	// skill and nothing else): the loop just above walks
	// Skill::getChildNode() starting from each LEARNED skill itself,
	// which correctly continues a skill WITHIN its own linear branch
	// chain (e.g. combat_marksman_rifle_01's real children do include
	// rifle_02) -- but a profession's branch boxes (rifle_01/pistol_01/
	// carbine_01/support_01) are NOT children of novice at all. Verified
	// against the real datatables/skill/skills.iff for every one of the
	// 34 real professions: novice, master, and every branch's tier-1 box
	// are all flat children of the PROFESSION ROOT itself (e.g.
	// "combat_marksman"), not of novice -- novice has ZERO real
	// children, which is exactly why the loop above found nothing
	// further once a companion has learned only its novice box. The real
	// gating for "is this branch box available yet" is a SEPARATE
	// column, SKILLS_REQUIRED (Skill::getSkillsRequired() -- already used
	// correctly elsewhere in this file by resolveSkillTreeDepth() and
	// trainSkill()'s own prerequisite walk above). Fix: for each learned
	// skill, derive its profession-root STRING the same way the other
	// two byProfession sources in this function already do (first two
	// underscore tokens), look that skill up directly by name, and walk
	// THAT node's real children -- for each child not yet learned, only
	// add it once every one of its getSkillsRequired() entries is already
	// learned (no requirements = always eligible). This correctly
	// surfaces rifle_01/pistol_01/carbine_01/support_01 the moment
	// novice is learned, and correctly withholds master until all four
	// _04 capstones are actually learned. (Deliberately NOT using the
	// existing resolveProfessionRoot() helper above -- it walks
	// Skill::getParent() all the way up through the domain row, e.g.
	// "combat", to SkillManager's internal synthetic root node, one
	// level too far for this lookup; that looks like a real, SEPARATE
	// pre-existing bug in the "Skill Sheet" screen's own profession-
	// header grouping, which reuses that same helper -- flagged to Nick
	// separately, not touched here.)
	for (int i = 0; i < companion->getLearnedSkillCount(); ++i) {
		const String& learnedName = companion->getLearnedSkill(i);

		int rootFirstUnderscore = learnedName.indexOf("_");
		int rootSecondUnderscore = rootFirstUnderscore >= 0 ? learnedName.indexOf("_", rootFirstUnderscore + 1) : -1;
		String professionRootName = rootSecondUnderscore > 0 ? learnedName.subString(0, rootSecondUnderscore) : learnedName;

		Skill* professionRoot = SkillManager::instance()->getSkill(professionRootName);

		if (professionRoot == nullptr) {
			continue;
		}

		for (int c = 0; c < professionRoot->getTotalChildren(); ++c) {
			const Skill* child = professionRoot->getChildNode(c);

			if (child == nullptr) {
				continue;
			}

			const String& name = child->getSkillName();

			if (companion->hasLearnedSkill(name)) {
				continue;
			}

			if (!name.beginsWith("combat_") && !name.beginsWith("crafting_") && !name.beginsWith("science_")
					&& !name.beginsWith("outdoors_") && !name.beginsWith("social_")) {
				continue;
			}

			const Vector<String>* required = child->getSkillsRequired();
			bool eligible = true;

			if (required != nullptr) {
				for (int r = 0; r < required->size(); ++r) {
					const String& prereq = required->get(r);

					if (!prereq.isEmpty() && !companion->hasLearnedSkill(prereq)) {
						eligible = false;
						break;
					}
				}
			}

			if (!eligible) {
				continue;
			}

			int childFirstUnderscore = name.indexOf("_");
			int childSecondUnderscore = childFirstUnderscore >= 0 ? name.indexOf("_", childFirstUnderscore + 1) : -1;
			String childRoot = childSecondUnderscore > 0 ? name.subString(0, childSecondUnderscore) : name;

			Vector<String> childList = byProfession.get(childRoot);

			if (childList.contains(name)) {
				continue;
			}

			childList.add(name);
			byProfession.drop(childRoot);
			byProfession.put(childRoot, childList);
		}
	}

	// Companion System (2026-07-28, "won't see those skills" gap fix --
	// see NOTES.md): sources (a) [owner's own held skills, loop above] and
	// (b) [immediate children of the companion's learned skills, loop just
	// above this one] only ever add a skill once the OWNER personally
	// holds something in that profession, or once the companion already
	// holds that child's own parent. That leaves a real gap Nick reported
	// ("if i am not that profession, i wont see those skills and i wont
	// know what their progression is"): if the owner personally has ZERO
	// skills in a profession, but the companion has learned skills there,
	// the TOP node of the companion's own chain (e.g. the novice/root box
	// itself) never got a row -- only ITS CHILDREN did, via source (b),
	// unless the owner also happened to hold it personally. Fix: every
	// skill the companion has ACTUALLY learned gets a row unconditionally,
	// third source, additive only -- (a) and (b) are untouched and still
	// useful ((a) shows what's ALSO available to train from the owner's
	// own repertoire, useful for professions the companion hasn't started).
	for (int i = 0; i < companion->getLearnedSkillCount(); ++i) {
		const String& name = companion->getLearnedSkill(i);

		if (!name.beginsWith("combat_") && !name.beginsWith("crafting_") && !name.beginsWith("science_")
				&& !name.beginsWith("outdoors_") && !name.beginsWith("social_")) {
			continue;
		}

		int firstUnderscore = name.indexOf("_");
		int secondUnderscore = firstUnderscore >= 0 ? name.indexOf("_", firstUnderscore + 1) : -1;
		String root = secondUnderscore > 0 ? name.subString(0, secondUnderscore) : name;

		Vector<String> list = byProfession.get(root);

		if (list.contains(name)) {
			continue;
		}

		list.add(name);
		byProfession.drop(root);
		byProfession.put(root, list);
	}

	ghost->closeSuiWindowType(SuiWindowType::COMPANION_SKILL_TREE);

	ManagedReference<SuiListBox*> sui = new SuiListBox(player, SuiWindowType::COMPANION_SKILL_TREE);
	sui->setPromptTitle(companion->getDisplayedName() + " -=COMPANION=- : Skill Tree");
	sui->setPromptText("Green = trained, grey = not. Click any box to train it (and everything it requires, lowest first).");
	sui->setCancelButton(true, "@ui:cancel");
	sui->setOkButton(true, "@ui:ok");

	// The row->skill map the callback trains from; empty string = a
	// non-training header/label row.
	Vector<String> rowSkills;

	auto addRow = [&sui, &rowSkills](const String& label, const String& skill) {
		sui->addMenuItem(label);
		rowSkills.add(skill);
	};

	for (int p = 0; p < byProfession.size(); ++p) {
		String root = byProfession.elementAt(p).getKey();
		Vector<String> skills = byProfession.get(root);

		// Order: novice, then sorted branch boxes, then master.
		String novice;
		String master;
		SortedVector<String> branches; // self-orders alphabetically

		for (int i = 0; i < skills.size(); ++i) {
			const String& s = skills.get(i);

			if (s.endsWith("_novice")) {
				novice = s;
			} else if (s.endsWith("_master")) {
				master = s;
			} else {
				branches.put(s);
			}
		}

		// Profession header.
		addRow("======== " + root + " ========", "");

		auto colored = [&companion](const String& skill, const String& indentLabel) -> String {
			bool trained = companion->hasLearnedSkill(skill);
			String color = trained ? "\\#33FF33" : "\\#888888";
			String mark = trained ? "[X] " : "[  ] ";
			return color + mark + indentLabel + "\\#FFFFFF";
		};

		// Companion System (2026-07-28, real per-skill XP cost display --
		// see NOTES.md): show the real per-skill cost right on the row for
		// anything not yet trained, using the SAME Skill* lookup pattern
		// already used above for resolveStfText("skl_n", ...). Auto-grantable
		// boxes show "(free)" instead so it's clear why no cost appears.
		// Already-trained ([X]/green) rows get no suffix -- nothing left to
		// spend on them.
		auto costSuffix = [this, &companion](const String& skill) -> String {
			if (companion->hasLearnedSkill(skill)) {
				return String();
			}

			if (isAutoGrantable(skill)) {
				return String(" (free)");
			}

			Skill* costSkill = SkillManager::instance()->getSkill(skill);

			if (costSkill == nullptr || costSkill->getXpType().isEmpty() || costSkill->getXpCost() <= 0) {
				return String(" (free)");
			}

			int xpCost = costSkill->getXpCost();
			int balance = companion->getExperience(costSkill->getXpType());
			int cappedBalance = balance > xpCost ? xpCost : balance;
			int percent = (int) (((float) cappedBalance / (float) xpCost) * 100.0f);

			if (percent > 100) {
				percent = 100;
			} else if (percent < 0) {
				percent = 0;
			}

			// Companion System (2026-07-28, per Nick: "show a progression bar
			// using '-'... and can we add in some color"): 10-segment text
			// progress bar toward this skill's real cost. Filled segments are
			// colored by how close the companion is (red/orange < 50%, yellow
			// 50-99%, green >= 100% -- the same green colored() above already
			// uses for a trained skill); empty segments stay a dim grey so the
			// bar always reads as a full 10-character track. Same inline
			// "\\#RRGGBB" markup convention colored() already uses above, reset
			// to white at the end the same way so it can't bleed color into
			// anything rendered after it.
			const int barWidth = 10;
			int filled = (percent * barWidth) / 100;

			if (filled > barWidth) {
				filled = barWidth;
			} else if (filled < 0) {
				filled = 0;
			}

			// Companion System (2026-07-29, per Nick: "change the color of
			// the '-' to green if we have completed that much, the grey its
			// using is to similar"): any progress actually banked now reads a
			// flat green (previously a red/orange-below-50-percent/yellow-
			// 50-to-99-percent gradient -- Nick wants "green = progress made",
			// not a red-means-behind read), and the empty/remaining segment is
			// a much darker near-black for real contrast against the green
			// fill (the previous \#444444 read too close to the fill color
			// in-game per Nick's direct report).
			String fillColor = "\\#33FF33";
			String bar = fillColor;

			for (int i = 0; i < filled; ++i) {
				bar += "-";
			}

			bar += "\\#1A1A1A";

			for (int i = filled; i < barWidth; ++i) {
				bar += "-";
			}

			bar += "\\#FFFFFF";

			return " " + bar + " " + String::valueOf(percent) + "% (needs " + String::valueOf(xpCost) + " " + costSkill->getXpType()
					+ ", have " + String::valueOf(balance) + ")";
		};

		if (!novice.isEmpty()) {
			addRow(colored(novice, resolveStfText("skl_n", novice)) + costSuffix(novice), novice);
		}

		for (int i = 0; i < branches.size(); ++i) {
			addRow(colored(branches.get(i), "    " + resolveStfText("skl_n", branches.get(i))) + costSuffix(branches.get(i)), branches.get(i));
		}

		if (!master.isEmpty()) {
			addRow(colored(master, resolveStfText("skl_n", master)) + costSuffix(master), master);
		}

		addRow(" ", "");
	}

	if (rowSkills.size() == 0) {
		player->sendSystemMessage("You don't hold any teachable profession skills yet.");
		return;
	}

	sui->setCallback(new CompanionTrainSkillSuiCallback(player->getZoneServer(), companion, rowSkills, true));

	ghost->addSuiBox(sui);
	player->sendMessage(sui->generateMessage());
}

