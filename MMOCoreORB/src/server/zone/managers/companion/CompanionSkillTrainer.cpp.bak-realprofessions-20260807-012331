}

static String describeAbilityMacro(const String& macroLower) {
	for (unsigned int i = 0; i < sizeof(ABILITY_MACRO_DESCRIPTIONS) / sizeof(ABILITY_MACRO_DESCRIPTIONS[0]); ++i) {
		if (macroLower == ABILITY_MACRO_DESCRIPTIONS[i].macro) {
			return String(ABILITY_MACRO_DESCRIPTIONS[i].description);
		}
	}

	return String();
}

// Companion System (2026-07-29, per Nick: "same issue with other
// naming... command browser... fix them all"): resolves a raw ability
// macro (e.g. "pointblankarea1") to its real cmd_n.stf friendly name
// ("Point Blank Area 1") the same way resolveStfText() already does
// elsewhere in this file -- but returns an EMPTY string instead of
// resolveStfText()'s own literal "@cmd_n:key" fallback when there's
// genuinely no real entry (custom companion-only macros like "camp"/
// "companionfollow" have none, confirmed empirically against the real
// extracted cmd_n.stf) -- so a row for one of those just keeps its
// plain slash-command form instead of showing a broken-looking
// "@cmd_n:camp" next to it.
static String friendlyCommandNameOrEmpty(const String& macroLower) {
	String resolved = resolveStfText("cmd_n", macroLower);

	if (resolved.beginsWith("@cmd_n:")) {
		return String();
	}

	return resolved;
}

void CompanionSkillTrainer::sendHelpSheet(CreatureObject* player, CompanionObject* companion) {
	if (player == nullptr || companion == nullptr) {
		return;
	}

	ManagedReference<PlayerObject*> ghost = player->getPlayerObject();

	if (ghost == nullptr) {
		return;
	}

	ghost->closeSuiWindowType(SuiWindowType::COMPANION_HELP_SHEET);

	ManagedReference<SuiListBox*> sui = new SuiListBox(player, SuiWindowType::COMPANION_HELP_SHEET);
	sui->setPromptTitle(companion->getDisplayedName() + " -=COMPANION=- : Command Reference");
	sui->setPromptText("@companion:help_text"); // /hpet <macro> -- readiness shown per row:
	sui->setCancelButton(false, "");
	sui->setOkButton(true, "@ui:ok");

	// Spec 4D: "registers the complete macro list across all professions,
	// tracking prerequisites, syntax layouts, and current readiness."
	// Companion System (2026-07-12): extended so every row also shows a
	// real, human-readable description of what the ability actually does,
	// not just its bare syntax -- see the ABILITY_MACRO_DESCRIPTIONS table
	// above this method. [READY] is kept on the always-learned rows for
	// UI consistency with the per-skill loop below (every ability listed
	// there is, by construction, already learned -- see that loop's own
	// comment).
	sui->addMenuItem("/hpet attack  -  " + describeAbilityMacro("attack") + "  [READY]");
	sui->addMenuItem("/hpet formup <line|wedge|box>  -  " + describeAbilityMacro("formup"));
	sui->addMenuItem("/hpet camp  -  " + describeAbilityMacro("camp"));
	sui->addMenuItem("/hpet help  -  " + describeAbilityMacro("help"));
	sui->addMenuItem(" ");
	sui->addMenuItem("-- On your own ability list, drag to hotbar (2026-07-13 pass) --");
	sui->addMenuItem("/companionfollow  -  " + describeAbilityMacro("companionfollow") + "  [HOTBAR-READY]");
	sui->addMenuItem("/companionstay  -  " + describeAbilityMacro("companionstay") + "  [HOTBAR-READY]");
	sui->addMenuItem("/companionpatrol  -  " + describeAbilityMacro("companionpatrol") + "  [HOTBAR-READY]");
	sui->addMenuItem("/companionstore  -  " + describeAbilityMacro("companionstore") + "  [HOTBAR-READY]");
	sui->addMenuItem("/companionattack  -  " + describeAbilityMacro("companionattack") + "  [HOTBAR-READY]");
	sui->addMenuItem("/companionformup  -  " + describeAbilityMacro("companionformup") + "  [HOTBAR-READY]");

	// Bug fix (2026-07-12): this loop used to surface EVERY raw skills.iff
	// COMMANDS-column entry a learned skill carried verbatim as
	// "/hpet <entry> [READY]" -- including entries that are not themselves
	// independently invokable through /hpet's single-macro dispatch: the
	// companion_master_* administrative commands (already listed correctly
	// above as their real top-level syntax), weapon certifications, and
	// category/argument-variant entries (see the big comment above
	// ABILITY_MACRO_DESCRIPTIONS). describeAbilityMacro() returns an empty
	// String for anything that isn't a real, independently-invokable macro,
	// and such entries are now skipped rather than advertised as working
	// syntax when they are not. seenMacros also de-dupes: a macro
	// referenced above (or already listed once from an earlier skill) is
	// never printed twice, even if two learned skills both grant it.
	Vector<String> seenMacros;
	seenMacros.add("attack");
	seenMacros.add("formup");
	seenMacros.add("camp");
	seenMacros.add("help");
	seenMacros.add("companionfollow");
	seenMacros.add("companionstay");
	seenMacros.add("companionpatrol");
	seenMacros.add("companionstore");
	seenMacros.add("companionattack");
	seenMacros.add("companionformup");
	seenMacros.add("hpet");
	seenMacros.add("hpet_formup");
	seenMacros.add("hpet_force_assist");

	for (int i = 0; i < companion->getLearnedSkillCount(); ++i) {
		const String& skillName = companion->getLearnedSkill(i);
		Skill* skill = SkillManager::instance()->getSkill(skillName);

		if (skill == nullptr) {
			continue;
		}

		const Vector<String>* abilities = skill->getAbilities();

		for (int j = 0; j < abilities->size(); ++j) {
			String macroLower = abilities->get(j).toLowerCase();

			if (seenMacros.contains(macroLower)) {
				continue;
			}

			seenMacros.add(macroLower);

			String description = describeAbilityMacro(macroLower);

			if (description.isEmpty()) {
				continue;
			}

			// Companion System (2026-07-13, "macro list" pass) -- 36 of these
			// (the badge-gated master combat profession abilities) now also
			// have their own dedicated "/companion<Ability>" command on the
			// owner's own abilityList (granted the moment this skill was
			// trained -- see grantOwnerAbilitiesForSkill()), draggable
			// straight to the hotbar exactly like a real character ability.
			// The older /hpet <macro> free-text form below still works too
			// (kept for backward compatibility / typing convenience).
			String friendlyCommandName = friendlyCommandNameOrEmpty(macroLower);
			String commandLabel = friendlyCommandName.isEmpty() ? macroLower : (macroLower + " (" + friendlyCommandName + ")");

			if (isMacroListReady(macroLower)) {
				sui->addMenuItem("/companion" + commandLabel + "  -  " + description + "  [HOTBAR-READY]");
			} else {
				sui->addMenuItem("/hpet " + commandLabel + "  -  " + description + "  [READY]");
			}
		}
	}

	ghost->addSuiBox(sui);
	player->sendMessage(sui->generateMessage());
}

// Companion System -- the 6 vanilla starting professions, keyed by their
// real, verified novice skill box names (crafting_artisan_novice,
// combat_brawler_novice, combat_marksman_novice, science_medic_novice,
// outdoors_scout_novice, social_entertainer_novice -- confirmed present in
// this server's actual skills.iff). Display names are resolved from the
// base game's own "@skl_n:<skillname>" localization, same as every other
// real profession in the client, so no new STF entries are needed for the
// list contents themselves -- only the SUI's title/prompt text.
static const char* COMPANION_STARTER_PROFESSIONS[] = {
	"crafting_artisan_novice",
	"combat_brawler_novice",
	"combat_marksman_novice",
	"science_medic_novice",
	"outdoors_scout_novice",
	"social_entertainer_novice",
};

void CompanionSkillTrainer::sendStarterProfessionChoice(CreatureObject* player, CompanionObject* companion) {
	if (player == nullptr || companion == nullptr) {
		return;
	}

	ManagedReference<PlayerObject*> ghost = player->getPlayerObject();

	if (ghost == nullptr) {
		return;
	}

	Vector<String> candidates;

	for (int i = 0; i < 6; ++i) {
		candidates.add(String(COMPANION_STARTER_PROFESSIONS[i]));
	}

	ghost->closeSuiWindowType(SuiWindowType::COMPANION_STARTER_PROFESSION);

	ManagedReference<SuiListBox*> sui = new SuiListBox(player, SuiWindowType::COMPANION_STARTER_PROFESSION);
	sui->setPromptTitle(companion->getDisplayedName() + " -=COMPANION=- : Choose Starting Profession");
	sui->setPromptText("@companion:starter_profession_text"); // Select the profession your companion will start as. This choice can only be made once, on your companion's first launch.
	sui->setCancelButton(false, ""); // Companion System: no cancel -- this is a mandatory one-time first-launch step, matching normal SWG character creation (you can't cancel out of picking a starting profession).
	sui->setOkButton(true, "@ui:ok");
	sui->setCallback(new CompanionStarterProfessionSuiCallback(player->getZoneServer(), companion, candidates));

	for (int i = 0; i < candidates.size(); ++i) {
		sui->addMenuItem(resolveStfText("skl_n", candidates.get(i)));
	}

	ghost->addSuiBox(sui);
	player->sendMessage(sui->generateMessage());
}

// Companion System (2026-07-20, "Master Jedi companion" pass, per user
// request) -- see the .h doc comment. Skill box names/COMMANDS values below
// were extracted directly from the real, currently-loadable base
// datatables/skill/skills.iff (not invented) -- see NOTES.md for the exact
// per-row data this was built from.
void CompanionSkillTrainer::grantMasterJediMastery(CreatureObject* owner, CompanionObject* companion, bool darkSide) const {
	if (companion == nullptr) {
		return;
	}

	// jedi_padawan_master is the shared gate both alignments pass through;
	// journeyman_master, the force_rank ladder, and force_title_jedi are
	// real, alignment-specific/alignment-agnostic chains from there.
	static const char* padawanTier[] = {
		"jedi_padawan_master",
	};

	static const char* lightJourneyman[] = { "jedi_light_side_journeyman_master" };
	static const char* darkJourneyman[] = { "jedi_dark_side_journeyman_master" };

	static const char* lightForceRank[] = {
		"force_rank_light", "force_rank_light_novice",
		"force_rank_light_rank_01", "force_rank_light_rank_02", "force_rank_light_rank_03",
		"force_rank_light_rank_04", "force_rank_light_rank_05", "force_rank_light_rank_06",
		"force_rank_light_rank_07", "force_rank_light_rank_08", "force_rank_light_rank_09",
		"force_rank_light_rank_10", "force_rank_light_master",
	};

	static const char* darkForceRank[] = {
		"force_rank_dark", "force_rank_dark_novice",
		"force_rank_dark_rank_01", "force_rank_dark_rank_02", "force_rank_dark_rank_03",
		"force_rank_dark_rank_04", "force_rank_dark_rank_05", "force_rank_dark_rank_06",
		"force_rank_dark_rank_07", "force_rank_dark_rank_08", "force_rank_dark_rank_09",
		"force_rank_dark_rank_10", "force_rank_dark_master",
	};

	// Shared by both alignments -- force_title_jedi_rank_01 is the real
	// skill LightsaberCrystalComponentImplementation.cpp gates crystal
	// tuning on; granting the full chain here is what would let this
	// companion tune its OWN replacement crystals later, not just use the
	// pre-tuned starting saber below.
	static const char* forceTitle[] = {
		"force_title_jedi_rank_01", "force_title_jedi_rank_02",
		"force_title_jedi_rank_03", "force_title_jedi_rank_04",
	};

	for (int i = 0; i < 1; ++i) {
		companion->grantSkill(padawanTier[i]);
	}

	if (darkSide) {
		for (int i = 0; i < 1; ++i) {
			companion->grantSkill(darkJourneyman[i]);
		}

		for (int i = 0; i < 13; ++i) {
			companion->grantSkill(darkForceRank[i]);
		}
	} else {
		for (int i = 0; i < 1; ++i) {
			companion->grantSkill(lightJourneyman[i]);
		}

		for (int i = 0; i < 13; ++i) {
			companion->grantSkill(lightForceRank[i]);
		}
	}

	for (int i = 0; i < 4; ++i) {
		companion->grantSkill(forceTitle[i]);
	}

	companion->setDarkSideJedi(darkSide);
	companion->grantCompanionBadge("jedi_master");
	companion->recalculateCombatLevel();

	// Owner hotbar abilities for the real Jedi commands these skills grant
	// (saberSlash2, saber1hComboHit2, saber1hHeadHit2, healBattleFatigueSelf2,
	// saber1hFlurry, saber2hHit3, saber2hFrenzy, saber2hBodyHit2, saberThrow2)
	// -- same generic call every other trainSkill() grant already uses.
	// NOTE: these specific ability macros won't actually be usable as owner
	// hotbar commands until they're also added to docs/companion_system/
	// tools/build_command_table_rows.py + build_ui_styles_patch.py, the same
	// way the existing 61 companion abilities were -- flagged as a follow-up
	// in NOTES.md, not yet done this pass. The companion can already FIGHT
	// with the saber right now regardless (see refreshCombatAttacks()'s new
	// lightsabermaster/forcepowermaster attack list) -- this only affects
	// whether the OWNER can manually trigger one of these specific named
	// abilities from their own hotbar.
	if (owner != nullptr) {
		grantOwnerAbilitiesForSkill(owner, "jedi_padawan_master");
		grantOwnerAbilitiesForSkill(owner, darkSide ? "jedi_dark_side_journeyman_master" : "jedi_light_side_journeyman_master");
	}

	// Companion System (2026-07-20) -- "maxed out PvP gear": a real,
	// pre-made legendary lightsaber (500-1000/1000-2000 damage, no
	// certification gate a companion would need to pass -- companions
	// aren't player creatures, so WeaponObjectImplementation::isCertifiedFor()
	// is skipped for them entirely anyway) rather than the separate
	// power-crystal/color-crystal SOCKET-INSERTION system real crafted
	// sabers use. Deliberate scope call, flagged in NOTES.md: automating the
	// live crystal-tuning flow (LightsaberCrystalComponentImplementation.cpp)
	// safely, without being able to compile-test this pass, was a bigger
	// risk than shipping a guaranteed-working pre-made legendary saber. Tell
	// me if you want the real socketed-crystal version built next.
	ZoneServer* zoneServer = companion->getZoneServer();

	if (zoneServer != nullptr) {
		ManagedReference<SceneObject*> saberObj = zoneServer->createObject(
				STRING_HASHCODE("object/weapon/melee/sword/sword_lightsaber_vader.iff"), 1);

		if (saberObj != nullptr) {
			WeaponObject* saber = saberObj.castTo<WeaponObject*>().get();

			if (saber == nullptr) {
				saberObj->destroyObjectFromDatabase(true);
			} else {
				Locker saberLocker(saber);

				String customName = darkSide ? "Master Jedi's Lightsaber (Dark)" : "Master Jedi's Lightsaber (Light)";
				saber->setCustomObjectName(customName, false);

				String errorDesc;

				if (companion->canAddObject(saber, 4, errorDesc) == 0) {
					companion->transferObject(saber, 4, true);
					companion->setWeapon(saber, true);
					companion->refreshCombatAttacks(saber);
				} else {
					saberObj->destroyObjectFromDatabase(true);
				}
			}
		}
	}
}

// Companion System (2026-07-20, "Master Jedi companion" pass) -- see the .h
// doc comment. Object-creation/slot-check idiom copied directly from
// claimAdditionalCompanion() just above (same device+companion pair
// pattern), then grantMasterJediMastery() is layered on top.
bool CompanionSkillTrainer::recruitMasterJediCompanion(CreatureObject* player, bool darkSide) const {
	if (player == nullptr) {
		return false;
	}

	ManagedReference<SceneObject*> datapad = player->getSlottedObject("datapad");

	if (datapad == nullptr) {
		return false;
	}

	int existingCount = 0;

	for (int i = 0; i < datapad->getContainerObjectsSize(); ++i) {
		SceneObject* obj = datapad->getContainerObject(i);

		if (obj != nullptr && obj->isCompanionControlDevice()) {
			existingCount++;
		}
	}

	int slots = player->getSkillMod("companion_slots");

	if (slots <= 0) {
		slots = 1;
	}

	if (existingCount >= slots) {
		player->sendSystemMessage("You already command your maximum of " + String::valueOf(slots)
				+ " companion(s) -- no room for a Master Jedi companion. Advance your Companion Handler training to command more.");
		return false;
	}

	ZoneServer* zoneServer = player->getZoneServer();

	if (zoneServer == nullptr) {
		return false;
	}

	ManagedReference<SceneObject*> deviceObj = zoneServer->createObject(String("object/intangible/companion/companion_control_device.iff").hashCode(), 1);
	ManagedReference<SceneObject*> companionObj = zoneServer->createObject(String("object/mobile/companion_actor.iff").hashCode(), 1);

	CompanionControlDevice* device = deviceObj != nullptr ? deviceObj.castTo<CompanionControlDevice*>() : nullptr;
	CompanionObject* companion = companionObj != nullptr ? companionObj.castTo<CompanionObject*>() : nullptr;

	if (device == nullptr || companion == nullptr) {
		player->error("CompanionSystem: recruitMasterJediCompanion could not create device/companion pair");
		return false;
	}

	Locker dlocker(device, player);

	String defaultName = darkSide ? "Dark Jedi Master" : "Jedi Master";

	{
		Locker clocker(companion, player);
		companion->setCompanionControlDevice(device);
		companion->setCustomObjectName(defaultName, true);
		// Companion System (2026-07-30): one-time random personality roll -- see NOTES.md.
		companion->setPersonalityType(1 + System::random(4));

		// Already fully built -- skip the normal first-summon
		// starter-profession picker (CompanionStarterProfessionSuiCallback).
		companion->setFirstLaunchComplete(true);

		grantMasterJediMastery(player, companion, darkSide);
	}

	device->setCompanionObject(companion);
	device->setForceNoTrade(true);
	device->setCustomObjectName(defaultName, true);

	datapad->transferObject(device, -1, true);
	datapad->broadcastObject(device, true);

	player->sendSystemMessage("The vendor hands you a control device for a " + defaultName
			+ " companion (" + String::valueOf(existingCount + 1) + " of " + String::valueOf(slots)
			+ " companion slots used). Summon it from your datapad.");

	return true;
}
