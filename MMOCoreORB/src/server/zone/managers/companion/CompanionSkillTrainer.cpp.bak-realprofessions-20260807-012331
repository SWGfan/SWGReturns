void CompanionSkillTrainer::sendTrainList(CreatureObject* player, CompanionObject* companion) {
	if (player == nullptr || companion == nullptr) {
		return;
	}

	ManagedReference<PlayerObject*> ghost = player->getPlayerObject();

	if (ghost == nullptr) {
		return;
	}

	// NOTE: candidate resolution here lists auto-grantable and
	// companion_master_* skills directly; badge-gated combat skill strings
	// are sourced the same way a real deployment would enumerate
	// SkillManager's loaded skill tree (SkillManager::instance()->getSkill()
	// walking children) filtered to combat professions the owner has a master
	// badge for. That enumeration step is intentionally left as an
	// integration TODO -- see NOTES.md, "Skill tree enumeration" -- since it
	// depends on this server's actual skills.iff content, which is not part
	// of this deliverable's scope.
	Vector<String> candidates;

	// Companion System (2026-07-27, per Nick: "companions are not to
	// learn the companion profession, lets remove that from the train
	// list"): the companion_master_* meta-tree (novice/husbandry/
	// resilience/discipline/vigilance/master) is deliberately NEVER
	// offered as a training candidate anymore. This does not touch any
	// companion that already has one of these skills learned -- it only
	// stops new grants going forward.

	if (isJediEligible(companion)) {
		if (!companion->hasLearnedSkill("jedi_teraskappa_01")) {
			candidates.add("jedi_teraskappa_01");
		}
	}

	// Companion System (2026-07-27, "Elite Companion Handler" pass): once
	// a companion has mastered companion_master_master, offer the new
	// profession's novice tier. This can't be discovered by the generic
	// learned-skill child-walk further down (companion_master_elite_novice's
	// PARENT is companion_master_elite, a different profession root, not a
	// child of companion_master_master) -- so it needs the same kind of
	// explicit, one-off candidate check jedi_teraskappa_01 used above.
	if (companion->hasLearnedSkill("companion_master_master")
			&& !companion->hasLearnedSkill("companion_master_elite_novice")) {
		candidates.add("companion_master_elite_novice");
	}

	// Companion System (2026-07-20, "can't train my companions in my
	// artisan skills" -- closes the long-standing "real profession skill
	// tree enumeration" TODO above): every REAL profession skill the OWNER
	// personally holds is a training candidate -- teach what you know
	// (mirrors ownerHasRequiredMasterBadge()'s matching owner->hasSkill()
	// pass, so everything listed here is actually grantable). Filtered to
	// the five profession domains; jedi/force stay behind the eligibility
	// gate above, and companion_master_/species/language noise is excluded
	// by the prefix filter naturally.
	const SkillList* ownerSkills = player->getSkillList();

	if (ownerSkills != nullptr) {
		for (int i = 0; i < ownerSkills->size(); ++i) {
			Reference<Skill*> ownerSkill = ownerSkills->get(i);

			if (ownerSkill == nullptr) {
				continue;
			}

			const String& name = ownerSkill->getSkillName();

			if (!name.beginsWith("combat_") && !name.beginsWith("crafting_") && !name.beginsWith("science_")
					&& !name.beginsWith("outdoors_") && !name.beginsWith("social_")) {
				continue;
			}

			if (companion->hasLearnedSkill(name) || candidates.contains(name)) {
				continue;
			}

			candidates.add(name);
		}
	}

	// Companion System (2026-07-28, per Nick: "train any profession" -- fixes
	// "my companions are only seeing the artisan items to craft and not the
	// actual items that are in their schematic list"): the "teach what you
	// know" pass above and the tree-walk pass below BOTH require the
	// companion (or the owner) to already have SOME foothold in a profession
	// before it can ever be offered -- neither can start a companion on a
	// brand new real profession the owner has never personally touched. That
	// is the actual cause of a companion being stuck forever on whatever its
	// one starter-profession pick was. Fix: always offer every real
	// profession's own novice tier as a candidate, independent of what the
	// owner or companion currently knows -- this is what actually delivers
	// "train any profession" as this project's own brief describes it. List
	// below is every real profession's novice row pulled directly from the
	// extracted base skills.iff (54 real IS_PROFESSION=1 blocks, enumerated
	// programmatically, not guessed) EXCEPT the jedi_/force_ trees (kept
	// behind the existing Force/Jedi eligibility gate above -- deliberate,
	// not an oversight) and the pilot_ trees (no established companion
	// piloting mechanic to hang this off of yet). A companion that already
	// has a tree's novice tier is skipped here -- the tree-walk pass below
	// is what offers it the NEXT tier once it has a foothold.
	static const char* ALL_REAL_PROFESSION_NOVICES[] = {
		"combat_1hsword_novice", "combat_2hsword_novice", "combat_bountyhunter_novice",
		"combat_brawler_novice", "combat_carbine_novice", "combat_commando_novice",
		"combat_marksman_novice", "combat_pistol_novice", "combat_polearm_novice",
		"combat_rifleman_novice", "combat_smuggler_novice", "combat_unarmed_novice",
		"crafting_architect_novice", "crafting_armorsmith_novice", "crafting_artisan_novice",
		"crafting_chef_novice", "crafting_droidengineer_novice", "crafting_merchant_novice",
		"crafting_shipwright_novice", "crafting_tailor_novice", "crafting_weaponsmith_novice",
		"outdoors_bio_engineer_novice", "outdoors_creaturehandler_novice", "outdoors_ranger_novice",
		"outdoors_scout_novice", "outdoors_squadleader_novice",
		"science_combatmedic_novice", "science_doctor_novice", "science_medic_novice",
		"social_dancer_novice", "social_entertainer_novice", "social_imagedesigner_novice",
		"social_musician_novice", "social_politician_novice"
	};

	for (uint32 i = 0; i < sizeof(ALL_REAL_PROFESSION_NOVICES) / sizeof(ALL_REAL_PROFESSION_NOVICES[0]); ++i) {
		String name(ALL_REAL_PROFESSION_NOVICES[i]);

		if (companion->hasLearnedSkill(name) || candidates.contains(name)) {
			continue;
		}

		candidates.add(name);
	}

	// Companion System (2026-07-27, root-cause fix for "crafting companions
	// never reach their top tier"): the "teach what you know" pass above
	// only offers a skill as a training candidate if the OWNER's own player
	// character personally holds it -- so a companion already partway up a
	// profession tree (e.g. granted its novice tier via the starter-profession
	// picker) could never be trained any further unless the owner had
	// *personally* mastered that same profession to the next tier too. Fix:
	// walk the real skill tree DIRECTLY from every skill the companion has
	// already learned -- for each of its immediate children (Skill::
	// getChildNode(), the same parent/child structure SkillManager builds
	// from the client skill data), offer it if the companion doesn't already
	// have it. This lets a companion progress its own tree regardless of what
	// the owner personally knows. Any multi-prerequisite skill (e.g. a
	// *_master box requiring several branch-04 skills at once) may appear as
	// a candidate slightly before every one of its prerequisites is met --
	// harmless, since trainSkill()'s own Skill::getSkillsRequired() recursion
	// still correctly backfills every other unmet branch bottom-up at the
	// moment it's actually selected, exactly as it does today.
	for (int i = 0; i < companion->getLearnedSkillCount(); ++i) {
		const String& learnedName = companion->getLearnedSkill(i);
		Skill* learnedSkill = SkillManager::instance()->getSkill(learnedName);

		if (learnedSkill == nullptr) {
			continue;
		}

		for (int c = 0; c < learnedSkill->getTotalChildren(); ++c) {
			const Skill* child = learnedSkill->getChildNode(c);

			if (child == nullptr) {
				continue;
			}

			const String& childName = child->getSkillName();

			if (companion->hasLearnedSkill(childName) || candidates.contains(childName)) {
				continue;
			}

			candidates.add(childName);
		}
	}

	// Companion System (2026-08-07, per user request "only show skills they
	// can learn at that time, do not show skills if the companion doesnt
	// have the prerequisite"): all three candidate passes above can each
	// surface a skill whose own Skill::getSkillsRequired() chain isn't
	// fully satisfied yet -- "teach what you know" can jump straight to a
	// tier the owner holds while the companion has none of that tree yet,
	// and the tree-walk pass above already documented its own multi-prereq
	// gap ("may appear... before every one of its prerequisites is met").
	// trainSkill() itself still correctly recurses and backfills any of
	// this if selected -- this filter only changes what's SHOWN, not what's
	// grantable, so nothing about that backfill-on-train behavior changes;
	// the list just now matches "ready right now."
	for (int i = candidates.size() - 1; i >= 0; --i) {
		if (!hasAllPrereqsMet(companion, candidates.get(i))) {
			candidates.remove(i);
		}
	}

	ghost->closeSuiWindowType(SuiWindowType::COMPANION_TRAIN_LIST);

	ManagedReference<SuiListBox*> sui = new SuiListBox(player, SuiWindowType::COMPANION_TRAIN_LIST);
	sui->setPromptTitle(companion->getDisplayedName() + " -=COMPANION=- : Train");
	sui->setPromptText("@companion:train_text"); // Select a skill to train (0 Skill Points required):
	sui->setCancelButton(true, "@ui:cancel");
	sui->setOkButton(true, "@ui:ok");
	sui->setCallback(new CompanionTrainSkillSuiCallback(player->getZoneServer(), companion, candidates));

	// Companion System (2026-07-29, per Nick: "same issue with other
	// naming... profession browser... fix them all"): resolve each
	// row through the real skl_n.stf, same as sendSkillTree()/
	// sendSkillSheet()/sendStarterProfessionChoice() already do in this
	// file -- only the DISPLAY text changes, `candidates` itself (used
	// by CompanionTrainSkillSuiCallback for the actual training logic)
	// stays the raw internal skill name.
	for (int i = 0; i < candidates.size(); ++i) {
		sui->addMenuItem(resolveStfText("skl_n", candidates.get(i)));
	}

	ghost->addSuiBox(sui);
	player->sendMessage(sui->generateMessage());
}

void CompanionSkillTrainer::sendUntrainList(CreatureObject* player, CompanionObject* companion) {
	if (player == nullptr || companion == nullptr) {
		return;
	}

	ManagedReference<PlayerObject*> ghost = player->getPlayerObject();

	if (ghost == nullptr) {
		return;
	}

	Vector<String> candidates;

	for (int i = 0; i < companion->getLearnedSkillCount(); ++i) {
		candidates.add(companion->getLearnedSkill(i));
	}

	ghost->closeSuiWindowType(SuiWindowType::COMPANION_UNTRAIN_LIST);

	ManagedReference<SuiListBox*> sui = new SuiListBox(player, SuiWindowType::COMPANION_UNTRAIN_LIST);
	sui->setPromptTitle(companion->getDisplayedName() + " -=COMPANION=- : Untrain");
	sui->setPromptText("@companion:untrain_text"); // Select a skill to remove:
	sui->setCancelButton(true, "@ui:cancel");
	sui->setOkButton(true, "@ui:ok");
	sui->setCallback(new CompanionUntrainSkillSuiCallback(player->getZoneServer(), companion, candidates));

	// Companion System (2026-07-29, per Nick: "same issue with other
	// naming... fix them all"): resolve each row through the real
	// skl_n.stf, same fix as sendTrainList() this same night -- only the
	// DISPLAY text changes, `candidates` itself (used by
	// CompanionUntrainSkillSuiCallback for the actual untrain logic)
	// stays the raw internal skill name.
	for (int i = 0; i < candidates.size(); ++i) {
		sui->addMenuItem(resolveStfText("skl_n", candidates.get(i)));
	}

	ghost->addSuiBox(sui);
	player->sendMessage(sui->generateMessage());
}

