		if (!ghost->hasAbility(macroAbility)) {
			ghost->addAbility(new Ability(macroAbility));
		}
	}
}

void CompanionSkillTrainer::sendSkillSheet(CreatureObject* player, CompanionObject* companion) {
	if (player == nullptr || companion == nullptr) {
		return;
	}

	ManagedReference<PlayerObject*> ghost = player->getPlayerObject();

	if (ghost == nullptr) {
		return;
	}

	ghost->closeSuiWindowType(SuiWindowType::COMPANION_SKILL_SHEET);

	ManagedReference<SuiListBox*> sui = new SuiListBox(player, SuiWindowType::COMPANION_SKILL_SHEET);
	// Companion System (2026-07-12, "real profession skill window" pass) --
	// every companion-related SUI window's title now always leads with the
	// companion's own name plus a "-=COMPANION=-" tag, so it's never
	// confused with the player's own real character sheet/Skills tab (which
	// this SUI is standing in for -- see NOTES.md for why extending the
	// real client Skills tab to a non-player CreatureObject isn't possible
	// from server-side C++ alone in this codebase).
	sui->setPromptTitle(companion->getDisplayedName() + " -=COMPANION=- : Skill Sheet");
	sui->setPromptText("@companion:skill_sheet_text"); // Skills this companion has learned:
	sui->setCancelButton(false, "");
	sui->setOkButton(true, "@ui:ok");

	sui->addMenuItem("Combat Level: " + String::valueOf(companion->getCombatLevel()));
	sui->addMenuItem(" ");

	// Group every learned skill by its real profession root (walking the
	// actual Skill tree SkillManager loaded from skills.iff), then sort each
	// group by real prerequisite depth, so the sheet reads novice -> tier
	// chains -> master, top to bottom, exactly like a real player's own
	// profession tree -- see resolveProfessionRoot()/resolveSkillTreeDepth()
	// above. This works generically whether the companion has trained in
	// the companion_master tree, a badge-gated real combat profession, or
	// both at once -- nothing here is hardcoded to any one profession's
	// branch names.
	Vector<String> professionNames;
	Vector<Vector<String> > professionSkills;

	for (int i = 0; i < companion->getLearnedSkillCount(); ++i) {
		const String& skillName = companion->getLearnedSkill(i);
		Skill* skill = SkillManager::instance()->getSkill(skillName);

		String professionName = skillName; // fallback: unresolvable skill gets its own group

		if (skill != nullptr) {
			Skill* root = resolveProfessionRoot(skill);

			if (root != nullptr) {
				professionName = root->getSkillName();
			}
		}

		int idx = professionNames.find(professionName);

		if (idx == -1) {
			professionNames.add(professionName);
			professionSkills.add(Vector<String>());
			idx = professionNames.size() - 1;
		}

		professionSkills.get(idx).add(skillName);
	}

	for (int p = 0; p < professionNames.size(); ++p) {
		Vector<String>& skillsInGroup = professionSkills.get(p);

		// Simple insertion sort by real prerequisite depth -- these lists are
		// tiny (a handful of tiers per profession at most), so O(n^2) here is
		// negligible.
		for (int i = 1; i < skillsInGroup.size(); ++i) {
			String key = skillsInGroup.get(i);
			int keyDepth = resolveSkillTreeDepth(SkillManager::instance()->getSkill(key));
			int j = i - 1;

			while (j >= 0 && resolveSkillTreeDepth(SkillManager::instance()->getSkill(skillsInGroup.get(j))) > keyDepth) {
				skillsInGroup.set(j + 1, skillsInGroup.get(j));
				--j;
			}

			skillsInGroup.set(j + 1, key);
		}

		// Section header -- resolveStfText() looks this up through the real
		// (patched) skl_n.stf server-side (see its definition above --
		// SuiListBox rows don't auto-resolve "@table:key" text the way a
		// SUI's own prompt title/text field does, confirmed live in-game).
		sui->addMenuItem("========== " + resolveStfText("skl_n", professionNames.get(p)) + " ==========");

		// Companion System (2026-07-24, per Nick's request "include a total
		// amount for each skill at the bottom so i know how much total they
		// have"): running per-profession-group totals, summed across every
		// learned skill box's real numeric mods (Skill::getSkillModifiers(),
		// the same source each per-box "+N" line below already comes from --
		// not parsed from display text). Built with plain Vector<String>/
		// Vector<int> + find()/get()/set() -- every one of those methods is
		// already proven safe elsewhere in this file (professionNames.find()
		// a few lines up, skillsInGroup.set() in the sort above) -- rather
		// than assuming VectorMap supports in-place value mutation, which
		// nobody has confirmed here.
		Vector<String> totalModNames;
		Vector<int> totalModValues;

		for (int i = 0; i < skillsInGroup.size(); ++i) {
			const String& skillName = skillsInGroup.get(i);
			Skill* skill = SkillManager::instance()->getSkill(skillName);

			sui->addMenuItem(resolveStfText("skl_n", skillName));

			if (skill == nullptr) {
				continue;
			}

			// Skill Mods this box grants -- resolveStfText() resolves through
			// the real (patched) stat_n.stf for every companion_* custom mod
			// key this project ships (see STAT_N_ENTRIES in
			// build_companion_content.py) and through the same table's stock
			// entries for any real combat-profession mod. "private_"-prefixed
			// keys are never shown, matching the real client's own info panel
			// (see NOTES.md's "Skill Mods panel" investigation).
			const VectorMap<String, int>* mods = skill->getSkillModifiers();

			for (int m = 0; m < mods->size(); ++m) {
				const String& modName = mods->elementAt(m).getKey();

				if (modName.beginsWith("private_")) {
					continue;
				}

				int modValue = mods->elementAt(m).getValue();
				String sign = modValue >= 0 ? "+" : "";

				sui->addMenuItem("     " + resolveStfText("stat_n", modName) + "  " + sign + String::valueOf(modValue));

				int totalIdx = totalModNames.find(modName);

				if (totalIdx == -1) {
					totalModNames.add(modName);
					totalModValues.add(modValue);
				} else {
					totalModValues.set(totalIdx, totalModValues.get(totalIdx) + modValue);
				}
			}

			// Commands/abilities this box grants -- "@cmd_n:" resolves
			// through the real (patched) cmd_n.stf the same way, splitting on
			// '+' first for the real "basecommand+argument" convention (e.g.
			// "flourish+1" resolves via "flourish") -- matching the real
			// client's own resolution rule confirmed in NOTES.md. "private_"/
			// "cert_"-prefixed entries are skipped, matching the real panel.
			const Vector<String>* abilities = skill->getAbilities();

			for (int a = 0; a < abilities->size(); ++a) {
				const String& command = abilities->get(a);
				String baseCommand = command;
				int plusPos = command.indexOf("+");

				if (plusPos != -1) {
					baseCommand = command.subString(0, plusPos);
				}

				if (baseCommand.beginsWith("private_") || baseCommand.beginsWith("cert_")) {
					continue;
				}

				sui->addMenuItem("     " + resolveStfText("cmd_n", baseCommand));
			}
		}

		if (totalModNames.size() > 0) {
			sui->addMenuItem("     ---- Totals for " + resolveStfText("skl_n", professionNames.get(p)) + " ----");

			for (int m = 0; m < totalModNames.size(); ++m) {
				int modValue = totalModValues.get(m);
				String sign = modValue >= 0 ? "+" : "";

				sui->addMenuItem("     " + resolveStfText("stat_n", totalModNames.get(m)) + "  TOTAL: " + sign + String::valueOf(modValue));
			}
		}

		sui->addMenuItem(" ");
	}

	ghost->addSuiBox(sui);
	player->sendMessage(sui->generateMessage());
}

// Companion System (2026-07-12, "stats window" pass) -- maps
// CompanionObject::FOLLOW/PATROL/STAY/ATTACK to display text. Kept file-local
// since companionState is a companion-only concept (see CompanionObject.idl),
// not a real client-recognized enum with its own STF table.
static String describeCompanionState(int state) {
	switch (state) {
	case CompanionObject::FOLLOW:
		return String("Follow");
	case CompanionObject::PATROL:
		return String("Patrol");
	case CompanionObject::STAY:
		return String("Stay");
	case CompanionObject::ATTACK:
		return String("Attack");
	default:
		return String("Unknown");
	}
}

void CompanionSkillTrainer::sendStatsSheet(CreatureObject* player, CompanionObject* companion) {
	if (player == nullptr || companion == nullptr) {
		return;
	}

	ManagedReference<PlayerObject*> ghost = player->getPlayerObject();

	if (ghost == nullptr) {
		return;
	}

	ghost->closeSuiWindowType(SuiWindowType::COMPANION_STATS_SHEET);

	ManagedReference<SuiListBox*> sui = new SuiListBox(player, SuiWindowType::COMPANION_STATS_SHEET);
	sui->setPromptTitle(companion->getDisplayedName() + " -=COMPANION=- : Stats");
	sui->setPromptText("Everything currently known about this companion's combat stats, vitality, and experience:");
	sui->setCancelButton(false, "");
	sui->setOkButton(true, "@ui:ok");

	// Vitals -- the real HAM pools (CreatureAttribute::HEALTH/ACTION/MIND),
	// the same values the client's own health/action/mind bars show when
	// this companion is targeted, plus combat level and its current
	// follow/stay/patrol state.
	sui->addMenuItem("========== Vitals ==========");
	sui->addMenuItem("Combat Level: " + String::valueOf(companion->getCombatLevel()));
	sui->addMenuItem("Health: " + String::valueOf(companion->getHAM(CreatureAttribute::HEALTH))
			+ " / " + String::valueOf(companion->getMaxHAM(CreatureAttribute::HEALTH)));
	sui->addMenuItem("Action: " + String::valueOf(companion->getHAM(CreatureAttribute::ACTION))
			+ " / " + String::valueOf(companion->getMaxHAM(CreatureAttribute::ACTION)));
	sui->addMenuItem("Mind: " + String::valueOf(companion->getHAM(CreatureAttribute::MIND))
			+ " / " + String::valueOf(companion->getMaxHAM(CreatureAttribute::MIND)));
	sui->addMenuItem("Current Order: " + describeCompanionState(companion->getCompanionState()));
	sui->addMenuItem(" ");

	// Companion Vitality -- the companion-specific, death-penalty-tracked
	// pool (separate from HAM health -- see CompanionObject.idl/NOTES.md,
	// "Medical hook"/"Death Loop & Vitality"). This is the number that
	// permanently shrinks (maxVitality) when the companion falls in battle.
	sui->addMenuItem("========== Companion Vitality ==========");
	sui->addMenuItem("Vitality: " + String::valueOf(companion->getVitality())
			+ " / " + String::valueOf(companion->getMaxVitality()));
	sui->addMenuItem(" ");

	// Resistances/armor -- real values from the companion's own AiAgent
	// template resistance (AiAgent.idl's getKinetic()/getEnergy()/etc.),
	// the same real getters/percentages the client's own Examine tooltip
	// already shows for this companion (see AiAgentImplementation::
	// fillAttributeList(), inherited as-is by CompanionObject).
	sui->addMenuItem("========== Resistances ==========");

	String armorLabel = "None";
	switch (companion->getArmor()) {
	case 1: armorLabel = "Light"; break;
	case 2: armorLabel = "Medium"; break;
	case 3: armorLabel = "Heavy"; break;
	default: break;
	}

	sui->addMenuItem("Armor Rating: " + armorLabel);
	sui->addMenuItem("Kinetic: " + String::valueOf((int)companion->getKinetic()) + "%");
	sui->addMenuItem("Energy: " + String::valueOf((int)companion->getEnergy()) + "%");
	sui->addMenuItem("Electricity: " + String::valueOf((int)companion->getElectricity()) + "%");
	sui->addMenuItem("Stun: " + String::valueOf((int)companion->getStun()) + "%");
	sui->addMenuItem("Blast: " + String::valueOf((int)companion->getBlast()) + "%");
	sui->addMenuItem("Heat: " + String::valueOf((int)companion->getHeat()) + "%");
	sui->addMenuItem("Cold: " + String::valueOf((int)companion->getCold()) + "%");
	sui->addMenuItem("Acid: " + String::valueOf((int)companion->getAcid()) + "%");
	sui->addMenuItem("Restraint (Lightsaber): " + String::valueOf((int)companion->getLightSaber()) + "%");
	sui->addMenuItem(" ");

	// Experience -- the one real, currently-used companion XP pool (see
	// NOTES.md, "companion_master_xp cost" section). companion's
	// experiencePools ledger isn't enumerable from outside CompanionObject
	// (no IDL accessor exists for it, and this pass deliberately avoids
	// hand-editing the autogen CompanionObject.h/.cpp pair for a new
	// getter -- see the "Was idlc.jar actually available" reasoning
	// earlier in NOTES.md for why that's treated as a bigger, separate
	// undertaking), so only the one pool every companion actually accrues
	// today is shown by direct lookup.
	sui->addMenuItem("========== Experience ==========");
	sui->addMenuItem("Companion Mastery XP: " + String::valueOf(companion->getExperience("companion_master_xp")));
	sui->addMenuItem(" ");

	// Badges Earned -- Companion System (2026-07-12, "badge tracking" pass):
	// real combat professions this companion has mastered at least once
	// (awarded by CompanionSkillTrainer::trainSkill(), never removed by
	// untraining), the same ledger isJediEligible() checks. "@stat_n:" isn't
	// used here since these are badge names, not SKILL_MODS keys -- there is
	// no real client string table for them, so they're shown as plain,
	// human-readable text.
	if (companion->getCompanionBadgeCount() > 0) {
		sui->addMenuItem("========== Badges Earned ==========");

		for (int i = 0; i < companion->getCompanionBadgeCount(); ++i) {
			sui->addMenuItem(companion->getCompanionBadge(i));
		}

		sui->addMenuItem(" ");
	}

	// Skill Bonuses -- aggregate totals from every learned skill's
	// SKILL_MODS, summed by key. IMPORTANT: these are informational only.
	// CompanionObjectImplementation::grantSkill() never calls the real
	// CreatureObject::addSkillMod() (confirmed in NOTES.md/
	// build_companion_content.py's own docstring: "none of the companion_*
	// SkillMod names ... are read by any getSkillMod() call"), so none of
	// these bonuses are actually applied to combat math yet -- wiring them
	// in is a legitimate, separate follow-up task, not something this pass
	// silently pretends is already live.
	Vector<String> modKeys;
	Vector<int> modTotals;

	for (int i = 0; i < companion->getLearnedSkillCount(); ++i) {
		Skill* skill = SkillManager::instance()->getSkill(companion->getLearnedSkill(i));

		if (skill == nullptr) {
			continue;
		}

		const VectorMap<String, int>* mods = skill->getSkillModifiers();

		for (int m = 0; m < mods->size(); ++m) {
			const String& modName = mods->elementAt(m).getKey();

			if (modName.beginsWith("private_")) {
				continue;
			}

			int modValue = mods->elementAt(m).getValue();
			int idx = modKeys.find(modName);

			if (idx == -1) {
				modKeys.add(modName);
				modTotals.add(modValue);
			} else {
				modTotals.set(idx, modTotals.get(idx) + modValue);
			}
		}
	}

	if (modKeys.size() > 0) {
		sui->addMenuItem("========== Skill Bonuses (learned -- not yet applied to combat) ==========");

		for (int i = 0; i < modKeys.size(); ++i) {
			int modValue = modTotals.get(i);
			String sign = modValue >= 0 ? "+" : "";

			sui->addMenuItem(resolveStfText("stat_n", modKeys.get(i)) + "  " + sign + String::valueOf(modValue));
		}
	}

	ghost->addSuiBox(sui);
	player->sendMessage(sui->generateMessage());
}

