// Companion System (2026-07-14, "Skill Sheet shows unresolved @table:key
// text" fix -- see NOTES.md). Confirmed live in-game (screenshot repro):
// SuiListBox addMenuItem() rows do NOT auto-resolve "@table:key"
// OutOfBand-style strings the way sendSystemMessage()/a SUI's own prompt
// title & text fields do -- even genuine, pre-existing stock keys like
// "carbine_accuracy" showed as literal "@stat_n:carbine_accuracy" text.
// This codebase already has a real, precedented server-side workaround for
// exactly this gap (StructureManager.cpp resolves
// "@player_structure:...".hashCode() via StringIdManager before handing SUI
// text to the client, for the same reason -- see its own "investigate sui
// packets" comment). Resolves eagerly, server-side, against every currently
// loaded string/en/*.stf file (which includes this project's own patched
// skl_n.stf/stat_n.stf/cmd_n.stf, already proven live since this same
// mechanism is what makes "@companion:skill_sheet_text" resolve correctly
// as this file's own SUI prompt text). Falls back to the raw "@table:key"
// text (rather than an empty row) if a key genuinely isn't in any loaded
// table, so a missing entry is still visible/debuggable instead of blank.
static String resolveStfText(const String& table, const String& key) {
	String fullPath = "@" + table + ":" + key;
	String resolved = StringIdManager::instance()->getStringId(fullPath.hashCode()).toString();

	return resolved.isEmpty() ? fullPath : resolved;
}

// Companion System (2026-07-12) -- generic tree-position helpers for
// sendSkillSheet(). Both walk the real Skill objects SkillManager loaded
// from skills.iff (the same data the client's own Skill Mods/Commands info
// panels resolve against, per NOTES.md's dated "Skill Mods panel" sections),
// so the sheet groups/orders a companion's learned skills exactly like a
// real profession tree without hardcoding any particular profession's
// branch names -- this works whether the companion has trained in the
// companion_master tree, a badge-gated real combat profession, or both.
//
// resolveProfessionRoot() walks Skill::getParent() (the PARENT column /
// graph-layout edge) up to the top of the tree -- the profession itself
// (e.g. "companion_master", "combat_brawler").
static Skill* resolveProfessionRoot(Skill* skill, int guard = 0) {
	if (skill == nullptr || guard > 32) {
		return skill;
	}

	Skill* parent = skill->getParent();

	if (parent == nullptr) {
		return skill;
	}

	// Companion System (2026-07-29, root-cause fix -- per Nick's wider
	// "fix the naming everywhere" ask): stop BEFORE climbing into the
	// top-level domain row itself (combat/crafting/science/outdoors/
	// social -- the five real domains every stock profession AND this
	// project's own companion_master/elite trees are parented under,
	// confirmed via the real skills.iff PARENT column). Every one of
	// those five domain rows has an empty PARENT field, which
	// SkillManager::loadClientData() defaults to attaching under its
	// own internal synthetic root node -- so the old version (no stop
	// condition besides "parent is null") climbed straight through the
	// domain row into that ONE shared synthetic root every time,
	// regardless of which profession was passed in, silently returning
	// the same node for every caller. This is what was collapsing
	// sendSkillSheet()'s profession-header grouping into one generic
	// label instead of "Marksman"/"Chef"/etc.
	const String& parentName = parent->getSkillName();

	if (parentName == "combat" || parentName == "crafting" || parentName == "science"
			|| parentName == "outdoors" || parentName == "social") {
		return skill;
	}

	return resolveProfessionRoot(parent, guard + 1);
}

// resolveSkillTreeDepth() walks Skill::getSkillsRequired() (the real
// prerequisite chain, distinct from PARENT -- see the "NOTE on PARENT vs
// SKILLS_REQUIRED" comment in build_companion_content.py) to compute how
// many tiers deep a skill sits: 0 for a novice/root box with no
// prerequisite, 1+N for anything gated behind another skill, and
// max(required tiers)+1 for a capstone/master row that requires more than
// one branch capstone at once. Used purely to sort each profession's
// learned skills into real tree order (novice -> tiers -> master) for
// display.
static int resolveSkillTreeDepth(Skill* skill, int guard = 0) {
	if (skill == nullptr || guard > 32) {
		return 0;
	}

	const Vector<String>* required = skill->getSkillsRequired();

	if (required == nullptr || required->size() == 0) {
		return 0;
	}

	int maxDepth = 0;

	for (int i = 0; i < required->size(); ++i) {
		Skill* req = SkillManager::instance()->getSkill(required->get(i));
		int depth = 1 + resolveSkillTreeDepth(req, guard + 1);

		if (depth > maxDepth) {
			maxDepth = depth;
		}
	}

	return maxDepth;
}

CompanionSkillTrainer::CompanionSkillTrainer() : Logger("CompanionSkillTrainer") {
	setGlobalLogging(true);
	setLogging(false);

	// Spec 3B: non-combat experience types a companion can never earn
	// (crafting tools, slicing terminals, genetic sampling, mission-terminal
	// tracking) -- any skill box gated behind one of these is auto-granted.
	//
	// Companion System (2026-07-28, real per-skill XP cost pass -- see
	// NOTES.md): "crafting_clothing_armor_xp", "crafting_weapons_xp", and
	// "crafting_medicine_xp" were REMOVED from this free list. They were
	// accurate when this list was written (companions could not craft at
	// all yet), but CompanionCraftingManager now lets a companion actually
	// craft real items, and (once its own separate crafting-XP-earn patch
	// lands the same night) will genuinely earn real crafting xpTypes
	// matching whatever a schematic declares -- so these three are no
	// longer "a companion can never earn" and should have to pay like
	// everything else now that they are genuinely earnable. "slicing_xp"
	// and "bio_engineer_dna_xp" STAY on this list -- no companion mechanic
	// exists for slicing terminals or DNA sampling minigames, so those
	// genuinely still can never be earned and must remain free.
	// JUDGMENT CALL (flag to Nick to revisit if it turns out wrong): this
	// assumes the parallel crafting-XP-earn patch actually lands and
	// awards these three xpTypes correctly. If it doesn't (or a specific
	// schematic's declared xpType doesn't match what a companion earns),
	// affected skills will look "stuck" (real cost, zero real income) and
	// one or more of these three may need to go back on this list.
	autoGrantXpTypes.add("slicing_xp");
	autoGrantXpTypes.add("bio_engineer_dna_xp");

	// Mission-gated career branches (spec 3B) -- matched by prefix so every
	// tier (_01.._04, etc.) of the branch is covered.
	autoGrantPrefixes.add("combat_bountyhunter_investigation_");

	// Spec 3C: baseline Master Combat Profession strings required before
	// jedi_* choices unlock. NOTE: these are asserted from the standard SWG
	// skill-tree naming convention (<profession>_master) -- cross-check
	// against the live skills.iff / skill_manager Lua config if profession
	// tree names differ on this install. See NOTES.md, "Skill string keys".
	jediGateMasterSkills.add("combat_fencer_master");
	jediGateMasterSkills.add("combat_swordsman_master");
	jediGateMasterSkills.add("combat_pikeman_master");
	jediGateMasterSkills.add("combat_rifleman_master");
	jediGateMasterSkills.add("combat_carbineer_master");
	jediGateMasterSkills.add("combat_pistoleer_master");
	jediGateMasterSkills.add("outdoors_smuggler_master");
	jediGateMasterSkills.add("combat_commando_master");
	jediGateMasterSkills.add("combat_bountyhunter_master");
	jediGateMasterSkills.add("social_squadleader_master");
	jediGateMasterSkills.add("science_combatmedic_master");
}

bool CompanionSkillTrainer::isAutoGrantable(const String& skillName) const {
	// A skill box is auto-grantable if its *name* falls in one of the
	// explicitly listed mission-gated prefixes, or if resolving it would
	// require xp of one of the listed non-combat types. Skill->xpType lookup
	// requires SkillManager's loaded Skill tree; since this system is
	// isolated from SkillManager entirely (see NOTES.md), the practical proxy
	// used here is a direct name-prefix match, which covers every case listed
	// in spec 3B without depending on SkillManager state at all.
	for (int i = 0; i < autoGrantPrefixes.size(); ++i) {
		if (skillName.beginsWith(autoGrantPrefixes.get(i))) {
			return true;
		}
	}

	for (int i = 0; i < autoGrantXpTypes.size(); ++i) {
		// e.g. "slicing_xp" -> skill boxes conventionally named "slicing_..."
		String xpPrefix = autoGrantXpTypes.get(i).replaceFirst("_xp", "");

		if (skillName.beginsWith(xpPrefix)) {
			return true;
		}
	}

	return false;
}

String CompanionSkillTrainer::resolveProfessionToken(const String& skillName) const {
	// Companion System (2026-08-07, verified against this project's own
	// extracted skills.iff -- docs/companion_system/tools/extracted/
	// skills.iff -- before touching this, since three of these mappings
	// were silently wrong):
	//
	// - "combat_carbineer_"/"combat_pistoleer_" do not exist ANYWHERE in
	//   this deployment's skill data (zero matches). The real elite skills
	//   are "combat_carbine_master"/"combat_pistol_master" -- corrected
	//   below. This means the master-badge fallback (owner mastered it
	//   before but doesn't currently hold the exact skill) has been
	//   silently broken for Carbine/Pistol since this function was written;
	//   the "owner currently holds the exact skill" path masked it.
	// - "outdoors_smuggler_" is also wrong -- the real skill is
	//   "combat_smuggler_master" (confirmed real, unlike carbineer/
	//   pistoleer) -- corrected below.
	// - "combat_fencer_"/"combat_swordsman_"/"combat_pikeman_"/
	//   "social_squadleader_" -- confirmed via the same skills.iff read that
	//   NONE of "combat_fencer_master", "combat_swordsman_master",
	//   "combat_pikeman_master", "social_squadleader_master" exist either.
	//   No equivalent real profession was found to correct these to, so
	//   they're deliberately left AS-IS rather than guessed at -- flagged
	//   to c3rr for verification (this also means isJediEligible()'s
	//   11-profession badge loop, which resolves these same 4 tokens plus
	//   "smuggler" via jediGateMasterSkills, may have been permanently
	//   unsatisfiable in this deployment; not fixed here, out of scope for
	//   today's request).
	// - "combat_marksman_carbine_"/"combat_marksman_rifle_"/
	//   "combat_marksman_pistol_" added (2026-08-07, per user request to
	//   let an owner who has mastered Carbine/Rifleman/Pistol train their
	//   companion in the matching Marksman specialization branch even
	//   without currently holding that exact box) -- these three branches
	//   are real, confirmed prerequisites of their matching elite novice
	//   tier (e.g. combat_carbine_novice's own SKILLS_REQUIRED includes
	//   combat_marksman_carbine_04), so mastering the elite tier is real
	//   proof the branch was already fully completed. The other marksman
	//   sub-branches this codebase's ALL_REAL_PROFESSION_NOVICES enumerates
	//   (polearm, 1h/2h sword, unarmed, etc.) are NOT gated behind a
	//   combat_marksman_ branch in this content -- confirmed no such
	//   branch exists in skills.iff for them -- so no bridge is needed or
	//   added for those.
	if (skillName.beginsWith("combat_bountyhunter_")) {
		return String("bountyhunter");
	} else if (skillName.beginsWith("combat_smuggler_")) {
		return String("smuggler");
	} else if (skillName.beginsWith("science_combatmedic_")) {
		return String("combatmedic");
	} else if (skillName.beginsWith("social_squadleader_")) {
		return String("squadleader");
	} else if (skillName.beginsWith("combat_commando_")) {
		return String("commando");
	} else if (skillName.beginsWith("combat_fencer_")) {
		return String("fencer");
	} else if (skillName.beginsWith("combat_swordsman_")) {
		return String("swordsman");
	} else if (skillName.beginsWith("combat_pikeman_")) {
		return String("pikeman");
	} else if (skillName.beginsWith("combat_rifleman_") || skillName.beginsWith("combat_marksman_rifle_")) {
		return String("rifleman");
	} else if (skillName.beginsWith("combat_carbine_") || skillName.beginsWith("combat_marksman_carbine_")) {
		return String("carbine");
	} else if (skillName.beginsWith("combat_pistol_") || skillName.beginsWith("combat_marksman_pistol_")) {
		return String("pistol");
	}

	// jedi_*, companion_master_*, and anything else unmapped.
	return String();
}

bool CompanionSkillTrainer::ownerHasRequiredMasterBadge(CreatureObject* owner, const String& skillName) const {
	if (owner == nullptr) {
		return false;
	}

	if (skillName.beginsWith("companion_master_") || isAutoGrantable(skillName)) {
		return true;
	}

	// Companion System (2026-07-20, "can't train my companions in my
	// artisan skills" -- see NOTES.md): you can teach your companion
	// anything YOU know. The owner personally holding the skill is at
	// least as strong a qualification as holding the profession's master
	// badge -- and it makes non-combat professions (artisan, architect,
	// medic, entertainer...) trainable at all, since resolveProfessionToken()
	// only maps combat professions and everything else failed closed.
	if (owner->hasSkill(skillName)) {
		return true;
	}

	ManagedReference<PlayerObject*> ghost = owner->getPlayerObject();

	if (ghost == nullptr) {
		return false;
	}

	if (ghost->isPrivileged()) {
		return true;
	}

	if (skillName.beginsWith("jedi_")) {
		// Jedi gating is handled separately via isJediEligible(); no single
		// badge governs it.
		return true;
	}

	String profession = resolveProfessionToken(skillName);

	if (profession.isEmpty()) {
		// Unknown/unmapped prefix -- fail closed.
		return false;
	}

	const Badge* badge = BadgeList::instance()->get(profession + "_master");

	if (badge == nullptr) {
		warning("CompanionSkillTrainer: no badge registered for '" + profession + "_master' -- denying by default. "
				"Verify the badge string key against the live badges table (see NOTES.md).");
		return false;
	}

	// Spec 3A: "The owner does NOT need to currently hold the profession,
	// just the historical master badge flag on their PlayerObject."
	return ghost->hasBadge(badge->getIndex());
}

bool CompanionSkillTrainer::isJediEligible(CompanionObject* companion) const {
	if (companion == nullptr) {
		return false;
	}

	// Companion System (2026-07-12, "badge tracking" pass): checks the
	// companion's own earned badges (see trainSkill()) rather than raw
	// learnedSkills strings -- holding the badge is proof this exact
	// profession was mastered at least once, per the user's own framing:
	// "they only need to have had the badge, if they have the badge, that
	// means they have once mastered it." jediGateMasterSkills still holds
	// the 11 baseline "_master" skill strings (unchanged) purely as the
	// canonical list of which professions gate Jedi eligibility;
	// resolveProfessionToken() turns each into the badge name actually
	// checked.
	for (int i = 0; i < jediGateMasterSkills.size(); ++i) {
		String profession = resolveProfessionToken(jediGateMasterSkills.get(i));

		if (profession.isEmpty()) {
			// Should never happen for this hardcoded list -- fail closed
			// rather than silently skip a gate.
			return false;
		}

		if (!companion->hasCompanionBadge(profession + "_master")) {
			return false;
		}
	}

	return true;
}

namespace {
	bool isCombatProfessionSkill(const String& skillName) {
		return skillName.beginsWith("combat_")
				|| skillName.beginsWith("outdoors_smuggler_")
				|| skillName.beginsWith("science_combatmedic_")
				|| skillName.beginsWith("social_squadleader_");
	}

	bool hasAllPrereqsMet(CompanionObject* companion, const String& skillName) {
		if (companion == nullptr) {
			return false;
		}

		Skill* skill = SkillManager::instance()->getSkill(skillName);

		if (skill == nullptr) {
			return true;
		}

		const Vector<String>* required = skill->getSkillsRequired();

		if (required == nullptr) {
			return true;
		}

		for (int i = 0; i < required->size(); ++i) {
			const String& prereq = required->get(i);

			if (!prereq.isEmpty() && !companion->hasLearnedSkill(prereq)) {
				return false;
			}
		}

		return true;
	}
}

bool CompanionSkillTrainer::trainSkill(CreatureObject* owner, CompanionObject* companion, const String& skillName) {
	if (owner == nullptr || companion == nullptr || skillName.isEmpty()) {
		return false;
	}

	if (companion->hasLearnedSkill(skillName)) {
		return false;
	}

	// Companion System (2026-07-20, per user request "if the skills before
	// it are required, train those first -- lowest box first, then up to the
	// desired one"): recursively satisfy every prerequisite skill the
	// SkillManager records for this box BEFORE granting it. Depth-first on
	// the real Skill::getSkillsRequired() chain means the lowest unmet
	// prerequisite is granted first and the requested box last -- exactly
	// the bottom-up training order. Cheap cycle guard via hasLearnedSkill()
	// (a granted prereq is skipped on re-entry).
	Skill* skill = SkillManager::instance()->getSkill(skillName);

	if (skill != nullptr) {
		const Vector<String>* required = skill->getSkillsRequired();

		if (required != nullptr) {
			for (int i = 0; i < required->size(); ++i) {
				const String& prereq = required->get(i);

				if (prereq.isEmpty() || companion->hasLearnedSkill(prereq)) {
					continue;
				}

				if (!trainSkill(owner, companion, prereq)) {
					owner->sendSystemMessage("Your companion couldn't be trained in the prerequisite '" + prereq + "' first.");
					return false;
				}
			}
		}
	}

	if (skillName.beginsWith("jedi_") && !isJediEligible(companion)) {
		owner->sendSystemMessage("@companion:jedi_not_eligible"); // This companion has not mastered every baseline combat profession.
		return false;
	}

	// Companion System (2026-07-27, "Elite Companion Handler" pass, per
	// user request "no jedi boxes in the companion profession ... only
	// unlocks when master companion handler is mastered"): the entire
	// companion_master_elite tree is gated behind the companion having
	// already mastered companion_master_master -- a plain hasLearnedSkill()
	// check, not a cross-profession SKILLS_REQUIRED reference (no real
	// profession in the base game ever points its SKILLS_REQUIRED at a
	// different profession's tree -- see NOTES.md's 2026-07-14 "Jedi
	// Companion" design research). jedi_teraskappa_01 (the old hidden
	// capstone this replaces) is gone entirely from skills.iff; this is a
	// new, separate gate, not a repurposing of isJediEligible()'s old
	// 11-combat-badge check.
	if (skillName.beginsWith("companion_master_elite") && !companion->hasLearnedSkill("companion_master_master")) {
		owner->sendSystemMessage("Your companion must master Companion Handler before it can begin training as an Elite Companion Handler.");
		return false;
	}

	// 2026-07-20 (user request "enable all profession trees, do not block
	// them off" -- the survey branch of Master Artisan was gated off): the
	// master-badge/owner-skill block was DISABLED for ALL professions,
	// combat and non-combat alike.
	//
	// 2026-08-07 (user request: companion trained Carbines I/II with the
	// owner never having held either box -- "i shouldnt have been able to
	// train the companion"): re-enabled, but SCOPED to combat professions
	// only, via isCombatProfessionSkill() above -- non-combat trees
	// (crafting/artisan/architect/etc.) stay exactly as open as the
	// 2026-07-20 request made them; nothing about that fix is reverted.
	// ownerHasRequiredMasterBadge() itself is unchanged: it already accepts
	// either the profession's master badge OR the owner simply holding that
	// exact skill (see its own doc comment, "teach your companion anything
	// YOU know"), and already fails closed for combat_marksman_*
	// (resolveProfessionToken() doesn't map it, and it's not one of the 11
	// badge-gated elite professions) -- so an owner without Carbine
	// training themselves is correctly denied with no change needed there.
	if (isCombatProfessionSkill(skillName) && !isAutoGrantable(skillName) && !ownerHasRequiredMasterBadge(owner, skillName)) {
		owner->sendSystemMessage("@companion:missing_master_badge");
		return false;
	}

	// Companion System (2026-07-28, real per-skill XP cost pass -- see
	// NOTES.md): Spec 1 + 3A/3B's old "cost is always 0" design is GONE.
	// Auto-grantable skills (isAutoGrantable() -- genuinely non-earnable xp
	// types / mission-gated prefixes) still cost nothing, same as always.
	// Everything else now has to be paid for out of the companion's OWN
	// isolated xp ledger (CompanionObject::addExperience()/getExperience()),
	// using the real per-skill cost data SkillManager already loaded from
	// skills.iff (Skill::getXpType()/getXpCost()) -- the same data a real
	// player's own skill-point spend already consults. "skill" here is the
	// SAME Skill* already resolved for skillName by the prereq-recursion
	// code above -- reused, not refetched. No valid cost data (no skill
	// row, empty xpType, or a non-positive xpCost) still falls back to
	// free -- a safe default so nothing silently breaks for a skill that
	// was never given clean cost data.
	if (!isAutoGrantable(skillName)) {
		if (skill != nullptr && !skill->getXpType().isEmpty() && skill->getXpCost() > 0) {
			const String& xpType = skill->getXpType();
			int xpCost = skill->getXpCost();
			int balance = companion->getExperience(xpType);

			if (balance < xpCost) {
				owner->sendSystemMessage("Your companion needs " + String::valueOf(xpCost - balance) + " more " + xpType
						+ " to learn this (has " + String::valueOf(balance) + "/" + String::valueOf(xpCost) + ").");
				return false;
			}

			companion->addExperience(xpType, -xpCost);
		}
	}

	companion->grantSkill(skillName);

	// Companion System (2026-07-12, "badge tracking" pass): the moment the
	// companion masters a real combat profession (its own "_master" skill
	// tier), award it the matching badge on its own ledger -- mirrors how a
	// real player earns a Master badge via PlayerManager::awardBadge(), but
	// scoped to the companion (see CompanionObject::grantCompanionBadge()).
	// This is what isJediEligible() checks instead of raw learnedSkills
	// strings. Idempotent (grantCompanionBadge() no-ops if already held), so
	// this is safe even if a "_master" skill is somehow granted twice.
	if (skillName.endsWith("_master")) {
		String profession = resolveProfessionToken(skillName);

		if (!profession.isEmpty()) {
			companion->grantCompanionBadge(profession + "_master");
		}
	}

	// Companion System (2026-07-13, "macro list" pass) -- put every real
	// ability this skill grants onto the OWNER's own macro/hotbar-visible
	// abilityList, exactly like a real player's own combat skills do for
	// themselves -- see grantOwnerAbilitiesForSkill() below.
	grantOwnerAbilitiesForSkill(owner, skillName);

	owner->sendSystemMessage("@companion:skill_trained"); // Your companion has learned a new skill.

	return true;
}

bool CompanionSkillTrainer::untrainSkill(CreatureObject* owner, CompanionObject* companion, const String& skillName) {
	if (owner == nullptr || companion == nullptr || skillName.isEmpty()) {
		return false;
	}

	if (!companion->hasLearnedSkill(skillName)) {
		return false;
	}

	// Must run first, while companion->hasLearnedSkill(skillName) is still
	// true (revokeOwnerAbilitiesForSkillIfUnused() explicitly skips
	// skillName by name when scanning for other still-learned grantors, so
	// this ordering isn't strictly required, but it keeps the intent clear
	// at this call site -- see CompanionSkillTrainer.h).
	revokeOwnerAbilitiesForSkillIfUnused(owner, companion, skillName);

	companion->removeSkill(skillName);

	owner->sendSystemMessage("@companion:skill_untrained"); // Your companion has forgotten a skill.

	return true;
}

void CompanionSkillTrainer::grantOwnerAbilitiesForSkill(CreatureObject* owner, const String& skillName) const {
	if (owner == nullptr || skillName.isEmpty()) {
		return;
	}

	ManagedReference<PlayerObject*> ghost = owner->getPlayerObject();

	if (ghost == nullptr) {
		return;
	}

	Skill* skill = SkillManager::instance()->getSkill(skillName);

	if (skill == nullptr) {
		return;
	}

	const Vector<String>* abilities = skill->getAbilities();

	if (abilities == nullptr) {
		return;
	}

	for (int i = 0; i < abilities->size(); ++i) {
		String macroAbility = "companion_" + abilities->get(i).toLowerCase();

		if (!ghost->hasAbility(macroAbility)) {
			ghost->addAbility(new Ability(macroAbility));
		}
	}
}

void CompanionSkillTrainer::revokeOwnerAbilitiesForSkillIfUnused(CreatureObject* owner, CompanionObject* companion, const String& skillName) const {
	if (owner == nullptr || companion == nullptr || skillName.isEmpty()) {
		return;
	}

	ManagedReference<PlayerObject*> ghost = owner->getPlayerObject();

	if (ghost == nullptr) {
		return;
	}

	Skill* skill = SkillManager::instance()->getSkill(skillName);

	if (skill == nullptr) {
		return;
	}

	const Vector<String>* abilities = skill->getAbilities();

	if (abilities == nullptr) {
		return;
	}

	for (int i = 0; i < abilities->size(); ++i) {
		const String& ability = abilities->get(i);
		bool stillGrantedElsewhere = false;

		for (int j = 0; j < companion->getLearnedSkillCount(); ++j) {
			const String& otherSkillName = companion->getLearnedSkill(j);

			if (otherSkillName == skillName) {
				continue;
			}

			Skill* otherSkill = SkillManager::instance()->getSkill(otherSkillName);

			if (otherSkill == nullptr) {
				continue;
			}

			const Vector<String>* otherAbilities = otherSkill->getAbilities();

			if (otherAbilities != nullptr && otherAbilities->contains(ability)) {
				stillGrantedElsewhere = true;
				break;
			}
		}

		if (!stillGrantedElsewhere) {
			String macroAbility = "companion_" + ability.toLowerCase();

			if (ghost->hasAbility(macroAbility)) {
				// Passed by address to a stack-local instance rather than a
				// heap-allocated one: PlayerObjectImplementation::removeAbility()
				// only uses it for a name-based find() against the real,
				// already-stored Ability* in abilityList (Ability::compareTo()
				// compares by abilityName, not pointer identity) and never
				// retains the pointer it's given, so there's nothing to keep
				// alive past this call -- unlike addAbility() below, which does
				// need a heap allocation since it stores the pointer.
				Ability macroAbilityLookup(macroAbility);
				ghost->removeAbility(&macroAbilityLookup);
			}
		}
	}
}

// Companion System (2026-07-15, "return to the trainer to claim additional
// companions" -- see NOTES.md, replacing the earlier instant-grant-N-at-
// novice shape per the user's revised design). Called every time a player
// converses with the Companion Master trainer (narrow template-name-gated
// hook in AiAgentImplementation::sendConversationStartTo()). Hands out ONE
// new companion control device per visit while the player's datapad holds
// fewer companions than their live companion_slots skill mod allows.
// Creation logic mirrors SkillManager.cpp's companion_master_novice grant
// block (device+companion pair, linked, no-trade, default nameplate) --
// the new companion's own first summon then runs the normal first-launch
// flow (starter profession picker + name popup).
void CompanionSkillTrainer::claimAdditionalCompanion(CreatureObject* player) const {
	if (player == nullptr || !player->hasSkill("companion_master_novice")) {
		return; // not a Companion Master -- ordinary trainer conversation only
	}

	ManagedReference<SceneObject*> datapad = player->getSlottedObject("datapad");

	if (datapad == nullptr) {
		return;
	}

	int existingCount = 0;

	for (int i = 0; i < datapad->getContainerObjectsSize(); ++i) {
		SceneObject* obj = datapad->getContainerObject(i);

		if (obj != nullptr && obj->isCompanionControlDevice()) {
			existingCount++;
		}
	}

	int slots = player->getSkillMod("companion_slots");

	if (slots <= 0) {
		slots = 1;
	}

	if (existingCount >= slots) {
		player->sendSystemMessage("You already command your maximum of " + String::valueOf(slots)
				+ " companion(s). Advance your Companion Handler training to command more.");
		return;
	}

	ZoneServer* zoneServer = player->getZoneServer();

	if (zoneServer == nullptr) {
		return;
	}

	ManagedReference<SceneObject*> deviceObj = zoneServer->createObject(String("object/intangible/companion/companion_control_device.iff").hashCode(), 1);
	ManagedReference<SceneObject*> companionObj = zoneServer->createObject(String("object/mobile/companion_actor.iff").hashCode(), 1);

	CompanionControlDevice* device = deviceObj != nullptr ? deviceObj.castTo<CompanionControlDevice*>() : nullptr;
	CompanionObject* companion = companionObj != nullptr ? companionObj.castTo<CompanionObject*>() : nullptr;

	if (device == nullptr || companion == nullptr) {
		player->error("CompanionSystem: claimAdditionalCompanion could not create device/companion pair");
		return;
	}

	// Same locking pattern as SkillManager.cpp's grant block (device held
	// across the transfer, companion crosslocked for its setters).
	Locker dlocker(device, player);

	// Companion System (2026-07-16, per user request): flat "Companion" now,
	// no number suffix -- was "Companion " + (existingCount + 1). Each fresh
	// companion gets renamed almost immediately anyway via the first-launch
	// profession picker's auto-popup rename box (CompanionStarterProfessionSuiCallback.h),
	// which now defaults ITS OWN input to the chosen profession's name
	// (e.g. "MARKSMAN") rather than this generic placeholder.
	String defaultName = "Companion";

	{
		Locker clocker(companion, player);
		companion->setCompanionControlDevice(device);
		companion->setCustomObjectName(defaultName, true);
		// Companion System (2026-07-30): one-time random personality roll -- see NOTES.md.
		companion->setPersonalityType(1 + System::random(4));
	}

	device->setCompanionObject(companion);
	device->setForceNoTrade(true);

	// Distinct datapad entry name too (2026-07-15, per user request) --
	// overwritten with the player's chosen name by the first-launch rename
	// popup / Rename Companion dialog (CompanionRenameSuiCallback.h).
	device->setCustomObjectName(defaultName, true);

	datapad->transferObject(device, -1, true);
	datapad->broadcastObject(device, true);

	player->sendSystemMessage("The trainer hands you a new companion control device (" + String::valueOf(existingCount + 1)
			+ " of " + String::valueOf(slots) + " companion slots used). Summon it from your datapad to get it started.");
}

void CompanionSkillTrainer::grantBaselineOwnerOrderAbilities(CreatureObject* owner) const {
	if (owner == nullptr) {
		return;
	}

	ManagedReference<PlayerObject*> ghost = owner->getPlayerObject();

	if (ghost == nullptr) {
		return;
	}

	// Companion System (2026-07-17, "pet command port" pass, per user
	// request) -- two changes here:
	// 1. BUG FIX: "companion_formup" was never in this list even though
	//    build_command_table_rows.py gates /companionformup on it -- the
	//    live symptom was "You do not have sufficient abilities to
	//    Companion Command: Form Up" for every player.
	// 2. The seven newly ported pet-order equivalents (guard / followother /
	//    rangedattack / specialone / specialtwo / group / friend) are
	//    baseline order abilities exactly like the original five.
	// 2026-07-20 ("massive battlefield" pass, per user request): added
	// "companion_return" (gates /companionreturn -- see
	// CompanionReturnCommand.h and build_command_table_rows.py).
	// 2026-07-20 ("crafting theater" pass, per user request): added
	// "companion_craft" (gates /companioncraft -- see
	// CompanionCraftCommand.h and build_command_table_rows.py).
	// 2026-07-25 ("Jenkins" pass, per user request "i also want a icon
	// macro i can use") -- added "companion_jenkins" so /jenkins actually
	// shows up in the owner's ability/command browser and can be dragged to
	// the hotbar, same as every other baseline order command. Unlike
	// companionrequestarmor (deliberately left ungated -- radial-only,
	// never meant to be hotbar-draggable), Jenkins needs a real ability
	// gate specifically because it's meant to live on the hotbar.
	//
	// BUG FIX (2026-07-25, live symptom: "companion_return"/"companion_
	// jenkins" never appeared in the Command Browser or the Skills panel's
	// "Commands and Abilities Granted" box, on any character that already
	// had this skill, no matter how many server/client restarts) --
	// PlayerObjectImplementation keeps TWO separate ability lists:
	// abilityList (persisted, what hasAbility() checks) and activeAbilities
	// (transient, rebuilt only in the constructor BEFORE the database
	// restore populates abilityList -- so on every server restart it comes
	// back empty for existing characters). addAbility()'s delta-message
	// that actually notifies the client and populates BOTH client-side
	// panels only fires when it adds something new to activeAbilities.
	// The old `if (!ghost->hasAbility(ability))` guard here checked the
	// PERSISTED list -- so for any character whose abilityList already had
	// an entry (from before a restart reset activeAbilities), this loop
	// permanently skipped re-notifying the client, forever. Fix: always
	// call addAbility() and let its own internal, per-list guards (one for
	// abilityList, one for activeAbilities) decide idempotency -- each list
	// gets topped up independently instead of the outer check silently
	// blocking the activeAbilities sync.
	static const char* baselineAbilities[] = {
		"companion_follow", "companion_stay", "companion_patrol",
		"companion_store", "companion_attack", "companion_formup",
		"companion_guard", "companion_followother", "companion_rangedattack",
		"companion_specialone", "companion_specialtwo", "companion_group",
		"companion_friend", "companion_return", "companion_craft",
		"companion_jenkins"
	};

	// COMPANION_ABILITYLIST_DEDUPE_FIX_2026_08_04 -- the 2026-07-25 change
	// above removed this loop's hasAbility() guard. That was correct on the
	// Companion fork's newer base, where addAbility() keeps TWO lists
	// (abilityList + activeAbilities) and guards each one internally, so an
	// outer check suppressed the client notification forever.
	//
	// Genesis is not that base. Here there is no activeAbilities list at all,
	// and AbilityList::add() blindly appends:
	//
	//     bool AbilityList::add(Ability* const& ability, DeltaMessage* message, int updates) {
	//         bool val = vector.add(ability);      // no duplicate check
	//
	// So the unguarded loop added 16 MORE duplicate entries to the player's
	// persisted, client-replicated ability list on every single summon, and
	// sent a delta message for each. That bloat is what buries the 61 genuine
	// companion ability macros -- which grantAllAbilitiesForTesting() grants
	// correctly and exactly once -- in the owner's Command Browser.
	//
	// Step 1: strip the duplicates already accumulated. Nothing else will
	// ever clean them up, and existing characters are already polluted.
	// getAbilityList() is declared `public final AbilityList getAbilityList()`
	// in PlayerObject.idl, so the generated accessor hands back a CONST
	// pointer -- every existing caller (PlayerInfoCommand, StartDanceCommand,
	// StartMusicCommand) binds it to `const AbilityList*`. Read through the
	// const pointer and cast only the individual entries we hand to
	// removeAbility(), which needs a mutable Ability*.
	const AbilityList* abilities = ghost->getAbilityList();

	if (abilities != nullptr) {
		int before = abilities->size();

		Vector<Ability*> duplicates;
		SortedVector<String> seen;

		for (int i = 0; i < abilities->size(); ++i) {
			Ability* entry = const_cast<Ability*>(abilities->get(i));

			if (entry == nullptr) {
				continue;
			}

			String key = entry->getAbilityName().toLowerCase();

			if (seen.contains(key)) {
				duplicates.add(entry);
			} else {
				seen.put(key);
			}
		}

		// Collect first, remove second -- removeAbility() mutates the same
		// vector we would otherwise be iterating.
		for (int i = 0; i < duplicates.size(); ++i) {
			ghost->removeAbility(duplicates.get(i));
		}

		if (duplicates.size() > 0) {
			info(true) << "CompanionSystem: stripped " << duplicates.size()
					<< " duplicate ability entries from player " << owner->getObjectID()
					<< " (" << before << " -> " << abilities->size() << ")";
		} else {
			info(true) << "CompanionSystem: player " << owner->getObjectID()
					<< " ability list clean, " << before << " entries";
		}
	}

	// Step 2: grant, guarded. On this base the guard is not an optimisation --
	// it is the only thing standing between this loop and unbounded growth.
	for (int i = 0; i < 16; ++i) {
		if (!ghost->hasAbility(baselineAbilities[i])) {
			ghost->addAbility(new Ability(baselineAbilities[i]));
		}
	}
}

// COMPANION_SKILLMOD_RESYNC_HOTFIX_2026_07_31 -- see CompanionSkillTrainer.h's doc comment on
// resyncSkillMods() for the full rationale.
void CompanionSkillTrainer::resyncSkillMods(CompanionObject* companion) const {
	if (companion == nullptr) {
		return;
	}

	VectorMap<String, int> correctTotals;

	for (int i = 0; i < companion->getLearnedSkillCount(); ++i) {
		Skill* skill = SkillManager::instance()->getSkill(companion->getLearnedSkill(i));

		if (skill == nullptr) {
			continue;
		}

		const VectorMap<String, int>* skillModifiers = skill->getSkillModifiers();

		if (skillModifiers == nullptr) {
			continue;
		}

		for (int m = 0; m < skillModifiers->size(); ++m) {
			const String& modName = skillModifiers->elementAt(m).getKey();
			int modValue = skillModifiers->elementAt(m).getValue();

			if (correctTotals.contains(modName)) {
				correctTotals.put(modName, correctTotals.get(modName) + modValue);
			} else {
				correctTotals.put(modName, modValue);
			}
		}
	}

	for (int i = 0; i < correctTotals.size(); ++i) {
		const String& modName = correctTotals.elementAt(i).getKey();
		int correctValue = correctTotals.elementAt(i).getValue();
		int currentValue = companion->getSkillMod(modName);
		int delta = correctValue - currentValue;

		if (delta != 0) {
			companion->addSkillMod(SkillModManager::SKILLBOX, modName, delta, false);
		}
	}
}

