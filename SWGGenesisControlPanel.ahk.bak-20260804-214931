; ============================ BACKUP SCHEDULE ================================
; Windows Task Scheduler, not cron: WSL has no init, so a crontab inside Debian
; only fires while something else is already keeping the distro alive -- which
; on a machine that gets shut down at night is precisely when it would not be.
; A Windows task starts the distro itself.
;
; Tasks run D:\SWGGenesis\run_backup.cmd rather than a long inline command,
; because schtasks /TR with nested quotes is a classic way to end up with a task
; that looks fine in the list and does nothing when it fires. The wrapper is
; plain text you can read and double-click to test.
BtnBackupSched.OnEvent("Click", ShowBackupSchedule)

RunCmdCapture(cmdLine) {
    tmp := NewTempPath()
    RunWait('cmd.exe /c ' . cmdLine . ' > "' . tmp . '" 2>&1', , "Hide")
    out := ""
    if FileExist(tmp) {
        out := FileRead(tmp)
        try FileDelete(tmp)
    }
    return out
}

WriteBackupWrapper(keepN, runMode) {
    global WSL_DISTRO, WSL_PY
    ; runMode: "auto" | "mysql" | "stop"
    argStr := "--auto"
    if (runMode = "mysql")
        argStr := "--mysql-only"
    else if (runMode = "stop")
        argStr := "--stop-first"

    body := "@echo off`r`n"
    body .= ":: Written by the SWGGenesis control panel -- Backup Schedule.`r`n"
    body .= ":: Safe to run by hand (double-click) to test exactly what the`r`n"
    body .= ":: scheduled task does.`r`n"
    body .= "echo.>> D:\SWGGenesis\backups\backup.log`r`n"
    body .= "echo ==== %DATE% %TIME% ====>> D:\SWGGenesis\backups\backup.log`r`n"
    body .= 'wsl.exe -d ' . WSL_DISTRO . ' --exec bash -lc "python3 ' . WSL_PY
    body .= ' backup_all ' . argStr . ' --keep ' . keepN
    body .= ' >> /mnt/d/SWGGenesis/backups/backup.log 2>&1"' . "`r`n"

    try DirCreate("D:\SWGGenesis\backups")
    try FileDelete("D:\SWGGenesis\run_backup.cmd")
    FileAppend(body, "D:\SWGGenesis\run_backup.cmd", "UTF-8-RAW")
}

ListBackupTasks() {
    out := RunCmdCapture('schtasks /Query /FO CSV /NH')
    times := []
    Loop Parse, out, "`n", "`r" {
        if !InStr(A_LoopField, "SWGGenesisBackup_")
            continue
        if RegExMatch(A_LoopField, "SWGGenesisBackup_(\d{4})", &m)
            times.Push(SubStr(m[1], 1, 2) . ":" . SubStr(m[1], 3, 2))
    }
    ; de-duplicate (a task can appear once per trigger row)
    seen := Map(), uniq := []
    for t in times {
        if !seen.Has(t) {
            seen[t] := 1
            uniq.Push(t)
        }
    }
    return uniq
}

; Pre-initialise, exactly as PlayersGui/TuneGui/PlanetsGui do above (867,
; 1025, 1185). AHK v2 THROWS when a global is read before assignment, so
; the IsObject() guard inside the function cannot be the first touch.
SchedGui := 0

ShowBackupSchedule(*) {
    global SchedGui, SchedLV, SchedMsg, SchedHour, SchedMin, SchedKeep, SchedMode, MyGui

    if IsObject(SchedGui) {
        try SchedGui.Destroy()
    }

    SchedGui := Gui("+Owner" . MyGui.Hwnd, "Genesis -- Nightly Backup Schedule")
    SchedGui.MarginX := 14
    SchedGui.MarginY := 12
    SchedGui.SetFont("s10", "Segoe UI")

    SchedGui.Add("Text", "w620",
        "Pick the time(s) you want a backup to run. Add as many as you like -- each one becomes its own Windows scheduled task.")
    SchedGui.Add("Text", "w620 cGray",
        "Uses Windows Task Scheduler, not cron: WSL has no init, so a crontab inside Debian only fires`n"
      . "while the distro is already running. A Windows task starts it for you.`n`n"
      . "Every run appends to D:\SWGGenesis\backups\backup.log.")

    SchedLV := SchedGui.Add("ListView", "w620 h150 -Multi Grid", ["Scheduled time", "Runs"])

    SchedGui.Add("Text", "xm y+12 w70", "Add time:")
    SchedHour := SchedGui.Add("DropDownList", "x+6 yp-4 w70 vSchedHour")
    Loop 24
        SchedHour.Add([Format("{:02}", A_Index - 1)])
    SchedHour.Choose(4)                       ; 03
    SchedGui.Add("Text", "x+4 yp+4 w10", ":")
    SchedMin := SchedGui.Add("DropDownList", "x+4 yp-4 w70 vSchedMin", ["00", "15", "30", "45"])
    SchedMin.Choose(1)
    BtnSAdd := SchedGui.Add("Button", "x+10 w100 h30", "Add")
    BtnSDel := SchedGui.Add("Button", "x+8 w130 h30", "Remove Selected")

    SchedGui.Add("Text", "xm y+14 w180", "If the server is RUNNING:")
    SchedMode := SchedGui.Add("DropDownList", "x+6 yp-4 w400 vSchedMode", [
        "Back up MySQL only, and log why  (recommended)",
        "Save, stop the server, back up, leave it stopped",
        "MySQL only, always -- never touch the object database"])
    SchedMode.Choose(1)

    SchedGui.Add("Text", "xm y+12 w180", "Keep this many backups:")
    SchedKeep := SchedGui.Add("Edit", "x+6 yp-4 w70 vSchedKeep Number", "6")
    SchedGui.Add("Text", "x+10 yp+4 w340 cGray", "~309 MB each, so 6 is under 2 GB.")

    BtnSApply := SchedGui.Add("Button", "xm y+16 w150 h32", "Apply Schedule")
    BtnSTest  := SchedGui.Add("Button", "x+10 w150 h32", "Run One Now")
    BtnSClear := SchedGui.Add("Button", "x+10 w150 h32", "Remove All")
    BtnSClose := SchedGui.Add("Button", "x+10 w130 h32", "Close")

    SchedMsg := SchedGui.Add("Text", "xm y+12 w620 r4 vSchedMsg", "")

    BtnSAdd.OnEvent("Click", (*) => (
        SchedLV.Add("", SchedHour.Text . ":" . SchedMin.Text, "Daily"),
        SchedMsg.Value := "Added " . SchedHour.Text . ":" . SchedMin.Text
            . " to the list. Nothing is scheduled until you press Apply Schedule."
    ))

    BtnSDel.OnEvent("Click", (*) => (
        (r := SchedLV.GetNext()) ? (SchedLV.Delete(r),
            SchedMsg.Value := "Removed from the list. Press Apply Schedule to write the change.")
          : SchedMsg.Value := "Select a row first."
    ))

    BtnSApply.OnEvent("Click", ApplyBackupSchedule)
    BtnSClear.OnEvent("Click", ClearBackupSchedule)
    BtnSTest.OnEvent("Click", (*) => (
        WriteBackupWrapper(SchedKeep.Value = "" ? 6 : SchedKeep.Value, ModeToken()),
        SchedMsg.Value := "Running the wrapper now, exactly as the scheduler would."
            . "`nWatch D:\SWGGenesis\backups\backup.log -- this can take a minute.",
        Run('cmd.exe /c "D:\SWGGenesis\run_backup.cmd"', , "Hide")
    ))
    BtnSClose.OnEvent("Click", (*) => SchedGui.Destroy())

    SchedGui.Show()
    LoadBackupSchedule()
}

ModeToken() {
    global SchedMode
    if (SchedMode.Value = 2)
        return "stop"
    if (SchedMode.Value = 3)
        return "mysql"
    return "auto"
}

LoadBackupSchedule() {
    global SchedLV, SchedMsg
    SchedLV.Delete()
    times := ListBackupTasks()
    for t in times
        SchedLV.Add("", t, "Daily")
    if (times.Length = 0)
        SchedMsg.Value := "No backup is scheduled yet. Add a time and press Apply Schedule."
    else
        SchedMsg.Value := "Currently scheduled: " . times.Length . " time(s) per day."
}

ApplyBackupSchedule(*) {
    global SchedLV, SchedMsg, SchedKeep

    keepN := SchedKeep.Value = "" ? 6 : SchedKeep.Value
    WriteBackupWrapper(keepN, ModeToken())

    ; Clear existing tasks first so the list in the window IS the schedule --
    ; no orphans left behind from a time you removed.
    old := ListBackupTasks()
    for t in old
        RunCmdCapture('schtasks /Delete /F /TN "SWGGenesisBackup_' . StrReplace(t, ":", "") . '"')

    msg := "", n := 0
    Loop SchedLV.GetCount() {
        tm := SchedLV.GetText(A_Index, 1)
        tn := "SWGGenesisBackup_" . StrReplace(tm, ":", "")
        out := RunCmdCapture('schtasks /Create /F /TN "' . tn . '" /SC DAILY /ST '
            . tm . ' /TR "D:\SWGGenesis\run_backup.cmd"')
        if InStr(out, "SUCCESS") {
            n++
        } else {
            msg .= "`nFAILED " . tm . ": " . TrimAll(out)
        }
    }

    if (n = 0 && SchedLV.GetCount() = 0) {
        SchedMsg.Value := "Schedule cleared -- no automatic backups will run."
            . "`nD:\SWGGenesis\run_backup.cmd is still there if you want to run it by hand."
    } else {
        SchedMsg.Value := "Scheduled " . n . " daily backup(s)."
            . "`nWrapper: D:\SWGGenesis\run_backup.cmd    Log: D:\SWGGenesis\backups\backup.log"
            . "`nKeeping the newest " . keepN . " backups." . msg
    }
    LoadBackupSchedule()
}

ClearBackupSchedule(*) {
    global SchedLV, SchedMsg
    old := ListBackupTasks()
    for t in old
        RunCmdCapture('schtasks /Delete /F /TN "SWGGenesisBackup_' . StrReplace(t, ":", "") . '"')
    SchedLV.Delete()
    SchedMsg.Value := "All " . old.Length . " scheduled backup(s) removed."
}



; ---- push target ------------------------------------------------------------
; The destination lives in git's own origin URL -- the same thing the label
; above reads and the same thing push uses. Setting it here therefore changes
; ONE thing and it persists; there is no second config file to drift out of
; sync with git.
BtnRemoteSet.OnEvent("Click", ChangePushTarget)

ChangePushTarget(*) {
    global PushUrl

    cur := PushUrl = "" ? "(none set)" : PushUrl

    ib := InputBox(
        "Where should Confirm && Push upload to?`n`n"
        . "Current target:`n" . cur . "`n`n"
        . "Paste a full git URL, for example:`n"
        . "    https://github.com/SWGfan/SWGReturns.git`n"
        . "    git@github.com:YourName/YourFork.git`n`n"
        . "Whatever you set becomes the default and stays until you change it`n"
        . "again -- it is saved as git's origin URL, so it survives reboots.",
        "Change push target", "w560 h300", PushUrl)

    if (ib.Result != "OK")
        return

    url := TrimAll(ib.Value)
    if (url = "")
        return

    ; The standing rule on this project, in your words: push only to SWGfan and
    ; let the other server pull. The menu enforces it; this just explains the
    ; refusal here rather than making you read the log to find out why.
    if InStr(url, "bfitzgit23") {
        ans := MsgBox(
            "That is the OTHER server's upstream repo (bfitzgit23).`n`n"
            . "Your standing rule for this project is to push only to SWGfan and let`n"
            . "them pull your edits -- it is why the box above says 'never to bfitzgit23'.`n`n"
            . "Set it anyway?",
            "That is the upstream repo", "YesNo Icon!")
        if (ans != "Yes")
            return
        SetLog(RunCapture('remote_set --url "' . url . '" --force'))
        RefreshRemote()
        return
    }

    SetLog(RunCapture('remote_set --url "' . url . '"'))
    RefreshRemote()
}


